#!/bin/bash

# تعريف الألوان المطلوبة بدقة
GOLD='\033[1;33m'
GRAY='\033[1;30m'     # رصاصي / رمادي غامق واضح
PURPLE='\033[0;35m'   # بنفسجي
BLUE='\033[1;34m'     # أزرق ملوكي واضح
GREEN='\033[0;32m'    # أخضر
RED='\033[0;31m'      # أحمر للتحذير والخروج
NC='\033[0m'          # بدون لون

# دالة لأخذ نسخة احتياطية قبل التعديل لحماية ملفاتك
backup_file() {
    if [ -f "$1" ]; then
        cp "$1" "$1.bak"
    fi
}

while true; do
    clear
    echo -e "${GOLD}======================================${NC}"
    echo -e "${GOLD}   🛡️  لوحة تحكم أبو حسين الذكية  🛡️${NC}"
    echo -e "${GOLD}======================================${NC}"

    # 1 و 2 و 3 باللون الرصاصي
    echo -e "${GRAY}1. فتح/استعراض ملفات المشروع (Backend)${NC}"
    echo -e "${GRAY}2. الدخول إلى مجلد الواجهة (Public)${NC}"
    echo -e "${GRAY}3. تنظيف وتحديث نسخة الهاتف (YTM + server.js)${NC}"

    # 4 و 5 و 6 و 7 باللون البنفسجي
    echo -e "${PURPLE}4. تحديث سريع ومباشر لملف واجهة المستخدم (index.html)${NC}"
    echo -e "${PURPLE}5. تحديث سريع ومباشر لملف سكريبت المستخدم (script.js)${NC}"
    echo -e "${PURPLE}6. تحديث سريع ومباشر لملف ستايل المستخدم (style.css)${NC}"
    echo -e "${PURPLE}7. تحديث سريع ومباشر لملف السيرفر (server.js)${NC}"

    # 555 باللون الأخضر
    echo -e "${GREEN}555. رفع التحديثات الجديدة للمتجر (./up)${NC}"

    # 44 باللون الأزرق المطور
    echo -e "${BLUE}44. تحديث سريع ومباشر لملف واجهة الأدمن (public/admin.html)${NC}"

    echo -e "${RED}0. خروج${NC}"
    echo -e "${GOLD}======================================${NC}"
    read -p "اختر رقماً (0-555): " choice

    case $choice in
        1)
            echo -e "${GREEN}📂 جاري الانتقال لمجلد الـ Backend... (اكتب exit للعودة للوحة Control)${NC}"
            cd ~/omnifeed-backend 2>/dev/null || mkdir -p ~/omnifeed-backend && cd ~/omnifeed-backend
            ls -la
            bash
            ;;
        2)
            echo -e "${GREEN}📂 جاري الانتقال لمجلد الـ Public... (اكتب exit للعودة للوحة Control)${NC}"
            cd ~/omnifeed-backend/public 2>/dev/null || mkdir -p ~/omnifeed-backend/public && cd ~/omnifeed-backend/public
            ls -la
            bash
            ;;
        3)
            echo -e "${RED}🗑️  جاري حذف النسخة السابقة من مجلد YTM...${NC}"
            rm -rf /sdcard/YTM
            mkdir -p /sdcard/YTM/
            
            echo -e "${GOLD}🔄 جاري نسخ الملفات الجديدة وآخر تحديث...${NC}"
            # نسخ محتويات مجلد public بالكامل
            cp -r ~/omnifeed-backend/public/* /sdcard/YTM/ 2>/dev/null
            # نسخ ملف السيرفر الرئيسي أيضاً كما طلبت
            if [ -f "~/omnifeed-backend/server.js" ]; then
                cp ~/omnifeed-backend/server.js /sdcard/YTM/
            elif [ -f "./server.js" ]; then
                cp ./server.js /sdcard/YTM/
            fi
            
            echo -e "${GREEN}✅ تم تنظيف المجلد واعتماد آخر نسخة بنجاح في YTM شاملة ملف السيرفر!${NC}"
            read -p "اضغط Enter للعودة..."
            ;;
        4)
            echo -e "${PURPLE}📥 الصق كود الـ HTML للمستخدم، ثم اضغط [Enter] ثم [Ctrl+D]:${NC}"
            mkdir -p ~/omnifeed-backend/public
            backup_file ~/omnifeed-backend/public/index.html
            cat > ~/omnifeed-backend/public/index.html
            echo -e "${GREEN}✅ تم التحديث بنجاح! (تم حفظ نسخة احتياطية)${NC}"
            sleep 1.5
            ;;
        5)
            echo -e "${PURPLE}📥 الصق كود الـ JavaScript للمستخدم، ثم اضغط [Enter] ثم [Ctrl+D]:${NC}"
            mkdir -p ~/omnifeed-backend/public
            backup_file ~/omnifeed-backend/public/script.js
            cat > ~/omnifeed-backend/public/script.js
            echo -e "${GREEN}✅ تم التحديث بنجاح! (تم حفظ نسخة احتياطية)${NC}"
            sleep 1.5
            ;;
        6)
            echo -e "${PURPLE}📥 الصق كود الـ CSS للمستخدم، ثم اضغط [Enter] ثم [Ctrl+D]:${NC}"
            mkdir -p ~/omnifeed-backend/public
            backup_file ~/omnifeed-backend/public/style.css
            cat > ~/omnifeed-backend/public/style.css
            echo -e "${GREEN}✅ تم التحديث بنجاح! (تم حفظ نسخة احتياطية)${NC}"
            sleep 1.5
            ;;
        7)
            echo -e "${PURPLE}📥 الصق كود الـ JavaScript الخاص بالسيرفر، ثم اضغط [Enter] ثم [Ctrl+D]:${NC}"
            mkdir -p ~/omnifeed-backend
            backup_file ~/omnifeed-backend/server.js
            cat > ~/omnifeed-backend/server.js
            echo -e "${GREEN}✅ تم تحديث ملف السيرفر بنجاح! (تم حفظ نسخة احتياطية)${NC}"
            sleep 1.5
            ;;
        555)
            echo -e "${GREEN}🚀 جاري تشغيل سكريبت الرفع المباشر...${NC}"
            if [ -f "~/omnifeed-backend/up" ] || [ -f "./up" ]; then
                cd ~/omnifeed-backend && chmod +x ./up && ./up
            else
                cd ~/omnifeed-backend && ./up
            fi
            read -p "اضغط Enter للعودة للوحة التحكم..."
            ;;
        44)
            echo -e "${BLUE}📥 الصق كود الـ HTML الخاص بملف الأدمن الجديد، ثم اضغط [Enter] ثم [Ctrl+D]:${NC}"
            mkdir -p ~/omnifeed-backend/public
            backup_file ~/omnifeed-backend/public/admin.html
            cat > ~/omnifeed-backend/public/admin.html
            echo -e "${GREEN}✅ تم تحديث ملف (public/admin.html) بنجاح!${NC}"
            sleep 1.5
            ;;
        0)
            echo -e "${RED}👋 تم الخروج من لوحة التحكم. في أمان الله يا أبو حسين!${NC}"
            return 2> /dev/null || exit
            ;;
        *)
            echo -e "${RED}❌ خيار غير صحيح.. يرجى اختيار رقم من القائمة${NC}"
            sleep 1.5
            ;;
    esac
done
