<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة تحكم أبو حسين المركزية</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght=400;700;900&display=swap" rel="stylesheet">
    <style>*{font-family:'Cairo',sans-serif;}</style>
</head>
<body class="bg-[#05070a] text-slate-100 min-h-screen pb-20">

    <audio id="snd-order-alert" src="https://assets.mixkit.co/active_storage/sfx/911/911-preview.mp3" preload="auto"></audio>
    <audio id="snd-success" src="https://assets.mixkit.co/active_storage/sfx/1435/1435-preview.mp3" preload="auto"></audio>

    <div id="adm-toast" class="fixed top-6 left-6 right-6 z-[5000] bg-emerald-500 text-black font-black p-5 rounded-2xl text-sm text-center shadow-2xl hidden transition-all duration-300"></div>

    <div id="admin-lock" class="fixed inset-0 z-[4000] bg-[#05070a] flex items-center justify-center p-6">
        <div class="max-w-md w-full bg-slate-900/40 p-8 rounded-3xl border border-white/5 space-y-6 text-center">
            <h2 class="text-2xl font-black text-emerald-400">منظومة الإدارة المركزية</h2>
            <input type="password" id="admin-key-input" class="w-full p-4 bg-black/60 border border-white/5 rounded-xl text-center font-black text-emerald-500 text-lg outline-none" placeholder="أدخل الرمز السري الفوقي">
            <button onclick="loginAdmin()" class="w-full bg-emerald-500 text-black font-black py-4 rounded-xl shadow-lg active:scale-95 transition">ولوج آمن للسيرفر</button>
        </div>
    </div>

    <div id="admin-content" class="hidden max-w-4xl mx-auto px-6 pt-10 space-y-8">
        <header class="flex justify-between items-center border-b border-white/5 pb-6">
            <div>
                <h1 class="text-3xl font-black text-emerald-400">لوحة تحكم أبو حسين</h1>
                <p class="text-xs text-slate-400 mt-1">إدارة كاملة للمتجر والعمليات والمحتوى</p>
            </div>
            <button onclick="manualDashboardRefresh()" class="bg-white/5 px-4 py-2 rounded-xl text-xs border border-white/5 font-bold text-emerald-400">تحديث البيانات 🔄</button>
        </header>

        <div class="flex gap-2 overflow-x-auto pb-2">
            <button onclick="switchTab('orders')" id="tab-orders" class="bg-emerald-500 text-black px-5 py-2.5 rounded-xl text-xs font-black shrink-0">📦 الطلبات والعمليات</button>
            <button onclick="switchTab('users')" id="tab-users" class="bg-white/5 text-slate-400 px-5 py-2.5 rounded-xl text-xs font-black shrink-0">👥 إدارة المحافظ والشحن</button>
            <button onclick="switchTab('inventory')" id="tab-inventory" class="bg-white/5 text-slate-400 px-5 py-2.5 rounded-xl text-xs font-black shrink-0">🛠️ تعديل وحذف الخدمات</button>
            <button onclick="switchTab('messages')" id="tab-messages" class="bg-white/5 text-slate-400 px-5 py-2.5 rounded-xl text-xs font-black shrink-0">📢 إرسال إشعار برقي</button>
            <button onclick="switchTab('settings')" id="tab-settings" class="bg-white/5 text-slate-400 px-5 py-2.5 rounded-xl text-xs font-black shrink-0">⚙️ إضافة خدمات وفيديوهات</button>
        </div>

        <div id="panel-orders" class="admin-panel space-y-4">
            <h3 class="font-black text-lg">سجل طلبات الفواتير الحالية</h3>
            <div id="adm-orders-list" class="space-y-3"></div>
        </div>

        <div id="panel-users" class="admin-panel hidden space-y-4">
            <h3 class="font-black text-lg">قائمة الحافظ الرقمية والشحن المباشر</h3>
            <div id="adm-users-list" class="space-y-3"></div>
        </div>

        <div id="panel-inventory" class="admin-panel hidden space-y-8">
            <div>
                <h3 class="font-black text-lg text-emerald-400 mb-3">📁 التحكم بالأقسام الحالية</h3>
                <div id="adm-categories-list" class="grid grid-cols-1 md:grid-cols-2 gap-3"></div>
            </div>
            <hr class="border-white/5">
            <div>
                <h3 class="font-black text-lg text-emerald-400 mb-3">🛍️ التحكم بالمنتجات والأسعار</h3>
                <div id="adm-products-list" class="grid grid-cols-1 gap-3"></div>
            </div>
        </div>

        <div id="panel-messages" class="admin-panel hidden space-y-6">
            <div class="bg-slate-900/30 p-6 rounded-3xl border border-white/5 max-w-lg space-y-4">
                <h3 class="font-black text-lg text-emerald-400">📢 بث إشعار جديد</h3>
                <select id="msg-receiver-type" class="w-full p-3.5 bg-black/60 border border-white/5 rounded-xl text-sm outline-none text-white">
                    <option value="ALL">للجميع</option>
                    <option value="INDIVIDUAL">لمستخدم محدد</option>
                </select>
                <div id="msg-phone-container" class="space-y-1 hidden">
                    <input type="tel" id="msg-phone" class="w-full p-3.5 bg-black/60 border border-white/5 rounded-xl text-sm text-white" placeholder="7xxxxxxxx">
                </div>
                <input type="text" id="msg-title" class="w-full p-3.5 bg-black/60 border border-white/5 rounded-xl text-sm text-white" placeholder="عنوان الإشعار">
                <textarea id="msg-body" class="w-full p-3.5 bg-black/60 border border-white/5 rounded-xl text-sm text-white h-24" placeholder="تفاصيل الرسالة..."></textarea>
                <button onclick="sendAdminMessage()" class="w-full bg-emerald-500 text-black font-black py-3 rounded-xl text-sm">بث الإشعار فوراً</button>
            </div>
        </div>

        <div id="panel-settings" class="admin-panel hidden grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-slate-900/20 p-6 rounded-3xl border border-white/5 space-y-3">
                <h4 class="font-black text-sm text-emerald-400">🎬 فيديو الإعلان الترويجي الأعلى</h4>
                <input type="text" id="set-ad-url" class="w-full p-3 bg-black/50 border border-white/5 rounded-xl text-xs" placeholder="ضع رابط فيديو يوتيوب هنا">
                <button onclick="addAd()" class="w-full bg-emerald-500 text-black font-black py-2.5 rounded-xl text-xs">حفظ وتحديث الفيديو</button>
            </div>
            <div class="bg-slate-900/20 p-6 rounded-3xl border border-white/5 space-y-3">
                <h4 class="font-black text-sm text-emerald-400">📁 إضافة قسم جديد</h4>
                <input type="text" id="cat-name" class="w-full p-3 bg-black/50 border border-white/5 rounded-xl text-xs" placeholder="اسم القسم">
                <input type="text" id="cat-sub" class="w-full p-3 bg-black/50 border border-white/5 rounded-xl text-xs" placeholder="وصف القسم الفرعي">
                <input type="text" id="cat-img" class="w-full p-3 bg-black/50 border border-white/5 rounded-xl text-xs" placeholder="رابط صورة القسم">
                <button onclick="addCategory()" class="w-full bg-emerald-500 text-black font-black py-2.5 rounded-xl text-xs">إنشاء القسم</button>
            </div>
            <div class="bg-slate-900/20 p-6 rounded-3xl border border-white/5 space-y-3 md:col-span-2">
                <h4 class="font-black text-sm text-emerald-400">🛍️ إضافة منتج جديد</h4>
                <input type="text" id="p-name" class="w-full p-3 bg-black/50 border border-white/5 rounded-xl text-xs" placeholder="اسم منتج الخدمة">
                <input type="number" id="p-price" class="w-full p-3 bg-black/50 border border-white/5 rounded-xl text-xs" placeholder="السعر (YER)">
                <input type="text" id="p-img" class="w-full p-3 bg-black/50 border border-white/5 rounded-xl text-xs" placeholder="رابط الصورة التوضيحية">
                <input type="text" id="p-cat" class="w-full p-3 bg-black/50 border border-white/5 rounded-xl text-xs" placeholder="اسم القسم التابع له (مطابق تماماً)">
                <button onclick="addProduct()" class="w-full bg-emerald-500 text-black font-black py-3 rounded-xl text-xs">تثبيت المنتج</button>
            </div>
        </div>
    </div>

    <script>
        const API = window.location.origin;
        let masterKey = "";
        let previousOrdersCount = -1;

        document.getElementById('msg-receiver-type').addEventListener('change', function() {
            document.getElementById('msg-phone-container').classList.toggle('hidden', this.value === 'ALL');
        });

        async function loginAdmin() {
            masterKey = document.getElementById('admin-key-input').value;
            await loadDashboard();
            setInterval(checkNewOrdersSilently, 10000);
        }

        async function manualDashboardRefresh() {
            await loadDashboard();
            showAdminToast("🔄 تم المزامنة بنجاح!");
        }

        async function loadDashboard() {
            let res = await fetch(`${API}/api/admin/dashboard`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ adminPass: masterKey })
            });
            let reply = await res.json();
            if(reply.success) {
                document.getElementById('admin-lock').classList.add('hidden');
                document.getElementById('admin-content').classList.remove('hidden');
                if(previousOrdersCount === -1) previousOrdersCount = reply.data.orders.length;
                renderAdminData(reply.data);
            } else { alert("❌ الرمز السري غير صحيح"); }
        }

        async function checkNewOrdersSilently() {
            try {
                let res = await fetch(`${API}/api/admin/dashboard`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ adminPass: masterKey })
                });
                let reply = await res.json();
                if(reply.success && reply.data.orders.length > previousOrdersCount) {
                    previousOrdersCount = reply.data.orders.length;
                    playAdminSound('snd-order-alert');
                    showAdminToast("🔔 تنبيه: هناك طلبية جديدة قادمة!");
                    renderAdminData(reply.data);
                }
            } catch(e){}
        }

        function renderAdminData(data) {
            document.getElementById('adm-orders-list').innerHTML = data.orders.map(o => `
                <div class="p-4 bg-white/5 rounded-2xl border border-white/5 flex flex-col md:flex-row justify-between items-center gap-2">
                    <div>
                        <div class="font-black text-emerald-400">${o.id} <span class="text-xs text-slate-400">(${o.phone})</span></div>
                        <div class="text-xs text-slate-300 mt-1">${o.items.map(i=>`${i.name} (x${i.qty})`).join(' | ')}</div>
                        <p class="text-[10px] text-slate-500 mt-1">${o.date} - <b class="text-emerald-500">${o.total} YER</b> [ ${o.status} ]</p>
                    </div>
                    <div class="flex gap-1">
                        <button onclick="updateStatus('${o.id}', 'مكتمل ✅')" class="bg-emerald-500 text-black px-3 py-1 rounded-lg text-xs font-bold">مكتمل</button>
                        <button onclick="updateStatus('${o.id}', 'مرفوض ❌')" class="bg-red-500/20 text-red-400 px-3 py-1 rounded-lg text-xs font-bold">رفض</button>
                    </div>
                </div>
            `).join('');

            document.getElementById('adm-users-list').innerHTML = data.users.map(u => `
                <div class="p-4 bg-white/5 rounded-2xl border border-white/5 flex justify-between items-center">
                    <div>
                        <h4 class="font-black text-sm">${u.name}</h4>
                        <p class="text-xs text-slate-400">📞 ${u.phone} | 💰 <span class="text-emerald-400">${u.bal} YER</span></p>
                    </div>
                    <button onclick="promptBalance('${u.phone}', ${u.bal})" class="bg-emerald-500 text-black px-3 py-1.5 rounded-xl text-xs font-black">
                        شحن المحفظة
                    </button>
                </div>
            `).join('');

            document.getElementById('adm-categories-list').innerHTML = (data.categories || []).map(c => `
                <div class="p-3 bg-slate-900/40 rounded-xl border border-white/5 flex justify-between items-center">
                    <div class="flex items-center gap-2">
                        <img src="${c.img}" class="w-8 h-8 object-cover rounded-md bg-slate-800">
                        <h4 class="text-xs font-black">${c.name}</h4>
                    </div>
                    <div class="flex gap-1">
                        <button onclick="editCategoryPrompt('${c.name}', '${c.sub}', '${c.img}')" class="p-2 bg-amber-500/10 text-amber-400 rounded-lg text-xs"><i class="fas fa-edit"></i></button>
                        <button onclick="deleteCategoryReq('${c.name}')" class="p-2 bg-red-500/10 text-red-400 rounded-lg text-xs"><i class="fas fa-trash-alt"></i></button>
                    </div>
                </div>
            `).join('');

            document.getElementById('adm-products-list').innerHTML = (data.products || []).map(p => `
                <div class="p-3 bg-slate-900/40 rounded-xl border border-white/5 flex justify-between items-center">
                    <div class="flex items-center gap-2">
                        <img src="${p.img}" class="w-10 h-10 object-cover rounded-xl bg-slate-800">
                        <div>
                            <h4 class="text-xs font-black">${p.name}</h4>
                            <p class="text-[10px] text-emerald-400">${p.price} YER <span class="text-slate-500">(${p.cat})</span></p>
                        </div>
                    </div>
                    <div class="flex gap-1">
                        <button onclick="editProductPrompt('${p.name}', ${p.price}, '${p.img}', '${p.cat}')" class="px-2 py-1 bg-amber-500/20 text-amber-400 rounded-md text-xs font-bold">تعديل</button>
                        <button onclick="deleteProductReq('${p.name}')" class="p-1.5 bg-red-500/10 text-red-400 rounded-md text-xs"><i class="fas fa-trash-alt"></i></button>
                    </div>
                </div>
            `).join('');
        }

        async function updateStatus(id, status) {
            await fetch(`${API}/api/admin/order/update-status`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ adminPass: masterKey, id, status })
            });
            playAdminSound('snd-success');
            showAdminToast(`📦 تم تحديث الطلب بنجاح!`);
            loadDashboard();
        }

        async function promptBalance(phone, currentBal) {
            const amount = prompt(`الرصيد الحالي: ${currentBal} YER\nأدخل الرصيد الجديد المستهدف كلياً:`);
            if(!amount || isNaN(amount)) return;
            await fetch(`${API}/api/admin/user/update-balance`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ adminPass: masterKey, phone, newBalance: Number(amount) })
            });
            playAdminSound('snd-success');
            showAdminToast("💰 تم تحديث رصيد المحفظة!");
            loadDashboard();
        }

        async function addAd() {
            const videoUrl = document.getElementById('set-ad-url').value;
            if(!videoUrl) return;
            await fetch(`${API}/api/admin/ad/add`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ adminPass: masterKey, videoUrl })
            });
            playAdminSound('snd-success');
            showAdminToast("🎬 تم تحديث الفيديو بنجاح!");
            document.getElementById('set-ad-url').value = '';
        }

        async function addCategory() {
            const name = document.getElementById('cat-name').value;
            const sub = document.getElementById('cat-sub').value;
            const img = document.getElementById('cat-img').value;
            await fetch(`${API}/api/admin/category/add`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ adminPass: masterKey, name, sub, img })
            });
            showAdminToast("📁 تم إضافة القسم!");
            loadDashboard();
        }

        async function addProduct() {
            const name = document.getElementById('p-name').value;
            const price = document.getElementById('p-price').value;
            const img = document.getElementById('p-img').value;
            const cat = document.getElementById('p-cat').value;
            await fetch(`${API}/api/admin/product/add`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ adminPass: masterKey, name, price, img, cat })
            });
            showAdminToast("🛍️ تم إضافة المنتج!");
            loadDashboard();
        }

        async function editCategoryPrompt(oldName, oldSub, oldImg) {
            const sub = prompt("تعديل الوصف:", oldSub);
            const img = prompt("تعديل رابط الصورة:", oldImg);
            if(sub === null || img === null) return;
            await fetch(`${API}/api/admin/category/edit`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ adminPass: masterKey, name: oldName, sub, img })
            });
            showAdminToast("📁 تم الحفظ!");
            loadDashboard();
        }

        async function deleteCategoryReq(name) {
            if(!confirm(`حذف القسم [ ${name} ]؟`)) return;
            await fetch(`${API}/api/admin/category/delete`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ adminPass: masterKey, name })
            });
            loadDashboard();
        }

        async function editProductPrompt(oldName, oldPrice, oldImg, oldCat) {
            const price = prompt("تعديل السعر:", oldPrice);
            const img = prompt("تعديل رابط الصورة:", oldImg);
            const cat = prompt("تعديل القسم:", oldCat);
            if(!price || isNaN(price) || img === null || !cat) return;
            await fetch(`${API}/api/admin/product/edit`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ adminPass: masterKey, name: oldName, price: Number(price), img, cat })
            });
            showAdminToast("🛍️ تم تحديث المنتج!");
            loadDashboard();
        }

        async function deleteProductReq(name) {
            if(!confirm(`حذف منتج [ ${name} ]؟`)) return;
            await fetch(`${API}/api/admin/product/delete`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ adminPass: masterKey, name })
            });
            loadDashboard();
        }

        function switchTab(tabId) {
            document.querySelectorAll('.admin-panel').forEach(p => p.classList.add('hidden'));
            document.querySelectorAll('[id^="tab-"]').forEach(b => b.classList.replace('bg-emerald-500', 'bg-white/5'));
            document.querySelectorAll('[id^="tab-"]').forEach(b => b.classList.replace('text-black', 'text-slate-400'));
            document.getElementById(`panel-${tabId}`).classList.remove('hidden');
            document.getElementById(`tab-${tabId}`).classList.replace('bg-white/5', 'bg-emerald-500');
            document.getElementById(`tab-${tabId}`).classList.replace('text-slate-400', 'text-black');
        }

        function showAdminToast(m) {
            const t = document.getElementById('adm-toast');
            t.innerText = m; t.classList.remove('hidden');
            setTimeout(() => t.classList.add('hidden'), 5000);
        }
        function playAdminSound(id) { const s = document.getElementById(id); if(s) { s.currentTime = 0; s.play().catch(e=>{}); } }
    </script>
</body>
</html>



