<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>إدارة تموينات أبو حسين</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
    <style>
        *{font-family:'Cairo',sans-serif; -webkit-tap-highlight-color: transparent;}
        .scrollbar-none::-scrollbar { display: none; }
        .panel-card { background: rgba(15, 23, 42, 0.4); border: 1px solid rgba(255, 255, 255, 0.05); backdrop-filter: blur(8px); }
        #permission-modal { display: none; position: fixed; inset: 0; z-index: 9999; background: rgba(0,0,0,0.85); backdrop-filter: blur(10px); align-items: center; justify-content: center; padding: 20px; }
        .permission-card { background: #0f172a; border: 1px solid #10b981; border-radius: 30px; max-width: 340px; width: 100%; padding: 30px; text-align: center; box-shadow: 0 20px 50px rgba(0,0,0,0.5); }
        .img-preview { width: 100%; height: 160px; border-radius: 20px; background-size: cover; background-position: center; display: none; margin-top: 15px; border: 2px solid #10b981; }
        input[type="file"] { display: none; }
    </style>
</head>
<body class="bg-[#030712] text-slate-100 min-h-screen pb-32">

    <!-- نافذة الأذونات -->
    <div id="permission-modal">
        <div class="permission-card">
            <h3 class="text-xl font-black text-white mb-2">إذن الوصول للصور</h3>
            <p class="text-slate-400 text-sm mb-8">يحتاج النظام للوصول لمعرض الصور لرفع صور المنتجات.</p>
            <div class="flex flex-col gap-3">
                <button onclick="invokeNativeGallery()" class="w-full bg-emerald-500 text-slate-950 font-black py-4 rounded-2xl">سماح بالوصول</button>
                <button onclick="closePermissionModal()" class="w-full text-slate-500 font-bold py-2">إلغاء</button>
            </div>
        </div>
    </div>

    <!-- المحتوى -->
    <div id="admin-content" class="max-w-6xl mx-auto px-4 pt-8 space-y-6">
        <!-- قسم إضافة منتج كمثال -->
        <div id="panel-add-product" class="admin-panel max-w-xl mx-auto panel-card p-6 rounded-2xl space-y-4">
            <h3 class="font-bold text-emerald-400">إضافة منتج جديد</h3>
            <div onclick="requestGalleryPermission('p-file')" class="p-5 bg-slate-800/50 border-2 border-dashed border-slate-700 rounded-2xl cursor-pointer">
                <i class="fas fa-camera text-emerald-400"></i> اختيار صورة
            </div>
            <input type="file" id="p-file" accept="image/*" onchange="handlePreview(this, 'p-preview-box')">
            <div id="p-preview-box" class="img-preview"></div>
        </div>
    </div>

    <script>
        let currentTargetInput = "";

        // دالة استقبال الصورة من الأندرويد
        window.handleSelectedImage = function(imagePath) {
            console.log("تم استلام مسار الصورة: " + imagePath);
            const previewBox = document.getElementById(currentTargetInput.replace('file', 'preview-box'));
            if (previewBox) {
                previewBox.style.backgroundImage = `url('${imagePath}')`;
                previewBox.style.display = 'block';
                // تفعيل المدخل برمجياً إذا لزم الأمر
                showToast("✅ تم اختيار الصورة بنجاح");
            }
        };

        function requestGalleryPermission(inputId) {
            currentTargetInput = inputId;
            document.getElementById('permission-modal').style.display = 'flex';
        }

        function closePermissionModal() {
            document.getElementById('permission-modal').style.display = 'none';
        }

        function invokeNativeGallery() {
            closePermissionModal();
            if (window.AndroidBridge && typeof window.AndroidBridge.openGallery === "function") {
                window.AndroidBridge.openGallery();
            } else {
                document.getElementById(currentTargetInput).click();
            }
        }

        function handlePreview(input, previewId) {
            const previewBox = document.getElementById(previewId);
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = (e) => {
                    previewBox.style.backgroundImage = `url(${e.target.result})`;
                    previewBox.style.display = 'block';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
        
        function showToast(msg) { alert(msg); }
    </script>
</body>
</html>

