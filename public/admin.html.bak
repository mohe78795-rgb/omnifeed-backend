<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة تحكم تموينات أبو حسين</title>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --bg-color: #0b0c10;
            --card-bg: #1f2833;
            --gold-primary: #c5a880;
            --gold-hover: #e5c59e;
            --white-text: #ffffff;
            --gray-text: #c5a88099;
            --green-success: #2ecc71;
            --red-danger: #e74c3c;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Tajawal', sans-serif; }
        body { background-color: var(--bg-color); color: var(--white-text); min-height: 100vh; padding: 20px; display: flex; flex-direction: column; align-items: center; }
        
        .header { width: 100%; max-width: 600px; text-align: center; margin-bottom: 25px; padding: 15px; border-bottom: 1px solid rgba(197, 168, 128, 0.2); }
        .header .logo-container { display: flex; align-items: center; justify-content: center; gap: 10px; }
        .header .logo-icon { background-color: var(--gold-primary); color: var(--bg-color); width: 35px; height: 35px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.2rem; }
        .header h1 { font-size: 1.6rem; font-weight: 700; }
        .header p { color: var(--gold-primary); font-size: 0.75rem; font-weight: 800; letter-spacing: 1.5px; }

        /* صندوق الرمز السري */
        .auth-box { width: 100%; max-width: 500px; background: var(--card-bg); border: 1px solid rgba(197, 168, 128, 0.3); border-radius: 15px; padding: 15px 20px; margin-bottom: 25px; display: flex; align-items: center; justify-content: space-between; box-shadow: 0 4px 15px rgba(0,0,0,0.5); }
        .auth-box input { background: rgba(11, 12, 16, 0.8); border: 1px solid rgba(197, 168, 128, 0.4); border-radius: 10px; padding: 8px 12px; color: var(--white-text); text-align: center; width: 150px; outline: none; }
        .auth-box input.success { border-color: var(--green-success); box-shadow: 0 0 8px var(--green-success); }

        /* أزرار الإجراءات السريعة */
        .quick-actions { width: 100%; max-width: 500px; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 25px; display: none; }
        .btn-action { background: transparent; border: 1px solid var(--gold-primary); color: var(--gold-primary); padding: 12px; border-radius: 12px; cursor: pointer; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 8px; transition: all 0.3s; }
        .btn-action:hover { background: var(--gold-primary); color: var(--bg-color); transform: translateY(-2px); }

        /* الكروت التفاعلية */
        .dashboard-grid { width: 100%; max-width: 500px; display: grid; grid-template-columns: 1fr; gap: 15px; }
        .dashboard-card { background: var(--card-bg); border-radius: 18px; padding: 20px; display: flex; align-items: center; justify-content: space-between; position: relative; border: 1px solid rgba(197, 168, 128, 0.15); transition: all 0.3s ease; cursor: pointer; }
        .dashboard-card::before { content: ''; position: absolute; top: 0; right: 0; width: 4px; height: 100%; background: var(--gold-primary); border-radius: 0 18px 18px 0; }
        .dashboard-card:hover { transform: translateY(-3px); border-color: var(--gold-primary); box-shadow: 0 8px 25px rgba(197, 168, 128, 0.15); }
        .card-details { display: flex; flex-direction: column; gap: 5px; }
        .card-title { font-size: 0.9rem; color: rgba(255, 255, 255, 0.7); }
        .card-value { font-size: 2rem; font-weight: 800; color: var(--gold-primary); }
        .card-icon { width: 50px; height: 50px; background: rgba(197, 168, 128, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--gold-primary); font-size: 1.4rem; border: 1px solid rgba(197, 168, 128, 0.2); }
        .dashboard-card:hover .card-icon { background: var(--gold-primary); color: var(--bg-color); }
        
        .blur-data { filter: blur(5px); user-select: none; }

        /* منطقة عرض الجداول التفصيلية */
        .details-section { width: 100%; max-width: 500px; margin-top: 25px; background: var(--card-bg); border-radius: 18px; border: 1px solid rgba(197, 168, 128, 0.2); padding: 20px; display: none; }
        .details-section h3 { color: var(--gold-primary); margin-bottom: 15px; font-size: 1.2rem; border-bottom: 1px solid rgba(197, 168, 128, 0.2); padding-bottom: 8px; }
        
        .data-item { background: rgba(11, 12, 16, 0.6); padding: 12px; border-radius: 10px; margin-bottom: 10px; border: 1px solid rgba(255,255,255,0.05); }
        .data-header { display: flex; justify-content: space-between; font-weight: 700; font-size: 0.95rem; margin-bottom: 5px; }
        .data-body { font-size: 0.85rem; color: rgba(255,255,255,0.7); margin-bottom: 8px; }
        
        .actions-row { display: flex; gap: 8px; justify-content: flex-end; }
        .btn-status { padding: 6px 12px; border-radius: 6px; border: none; cursor: pointer; font-weight: 700; font-size: 0.8rem; }
        .btn-accept { background: var(--green-success); color: #fff; }
        .btn-cancel { background: var(--red-danger); color: #fff; }

        .footer-note { margin-top: 40px; font-size: 0.75rem; color: var(--gray-text); }
    </style>
</head>
<body>

    <div class="header">
        <div class="logo-container"><div class="logo-icon">T</div><h1>تموينات أبو حسين</h1></div>
        <p>PREMIUM PLATFORM</p>
    </div>

    <!-- صندوق الرمز السري لإلغاء الغبش وتفعيل النظام -->
    <div class="auth-box">
        <label>رمز الإدارة السري:</label>
        <input type="password" id="admin-pin" placeholder="••••••" maxlength="6" oninput="checkPin(this.value)">
    </div>

    <!-- أزرار الإجراءات السريعة الفعالة -->
    <div class="quick-actions" id="actionsPanel">
        <button class="btn-action" onclick="addNewProduct()"><i class="fa-solid fa-plus"></i> إضافة منتج</button>
        <button class="btn-action" onclick="addNewCategory()"><i class="fa-solid fa-folder-plus"></i> إضافة قسم</button>
    </div>

    <!-- شبكة الكروت التفاعلية -->
    <div class="dashboard-grid">
        <div class="dashboard-card" onclick="showDetails('products')">
            <div class="card-details"><span class="card-title">إجمالي المنتجات</span><span class="card-value blur-data" id="val-prod">...</span></div>
            <div class="card-icon"><i class="fa-solid fa-box-open"></i></div>
        </div>

        <div class="dashboard-card" onclick="showDetails('orders')">
            <div class="card-details"><span class="card-title">الطلبات المعلقة</span><span class="card-value blur-data" id="val-ord">...</span></div>
            <div class="card-icon"><i class="fa-solid fa-clock-rotate-left"></i></div>
        </div>

        <div class="dashboard-card" onclick="showDetails('users')">
            <div class="card-details"><span class="card-title">إجمالي المستخدمين</span><span class="card-value blur-data" id="val-user">...</span></div>
            <div class="card-icon"><i class="fa-solid fa-users"></i></div>
        </div>

        <div class="dashboard-card" onclick="showDetails('categories')">
            <div class="card-details"><span class="card-title">إجمالي الأقسام</span><span class="card-value blur-data" id="val-cat">...</span></div>
            <div class="card-icon"><i class="fa-solid fa-layer-group"></i></div>
        </div>
    </div>

    <!-- نافذة تفاصيل البيانات وعمليات معالجة الطلبات الحقيقية -->
    <div class="details-section" id="detailsPanel">
        <h3 id="detailsTitle">تفاصيل البيانات</h3>
        <div id="detailsContent"></div>
    </div>

    <div class="footer-note">نظام إدارة تموينات أبو حسين السحابي © 2026</div>

    <script>
        let currentPin = "";

        // دالة التحقق من الرمز وجلب الإحصائيات الحقيقية فوراً عند صحته
        async function checkPin(value) {
            currentPin = value;
            const pinInput = document.getElementById('admin-pin');
            
            // نحاول عمل استدعاء للـ Stats بالسيرفر لاختبار صحة الرمز السري
            try {
                const response = await fetch(`/api/admin/stats?adminPass=${value}`);
                if(response.ok) {
                    const data = await response.json();
                    pinInput.classList.add('success');
                    document.getElementById('actionsPanel').style.display = 'grid';
                    
                    // إزالة الغبش وتحديث الكروت بالبيانات الحقيقية
                    document.getElementById('val-prod').innerText = data.productsCount;
                    document.getElementById('val-ord').innerText = data.pendingOrders;
                    document.getElementById('val-user').innerText = data.usersCount;
                    document.getElementById('val-cat').innerText = data.categoriesCount;
                    
                    document.querySelectorAll('.card-value').forEach(el => el.classList.remove('blur-data'));
                } else {
                    resetLock();
                }
            } catch (error) {
                resetLock();
            }
        }

        function resetLock() {
            const pinInput = document.getElementById('admin-pin');
            pinInput.classList.remove('success');
            document.getElementById('actionsPanel').style.display = 'none';
            document.getElementById('detailsPanel').style.display = 'none';
            document.querySelectorAll('.card-value').forEach(el => {
                el.classList.add('blur-data');
                el.innerText = "...";
            });
        }

        // دالة جلب وتحديث الإحصائيات السريعة بانتظام
        async function refreshStats() {
            try {
                const response = await fetch(`/api/admin/stats?adminPass=${currentPin}`);
                if(response.ok) {
                    const data = await response.json();
                    document.getElementById('val-prod').innerText = data.productsCount;
                    document.getElementById('val-ord').innerText = data.pendingOrders;
                    document.getElementById('val-user').innerText = data.usersCount;
                    document.getElementById('val-cat').innerText = data.categoriesCount;
                }
            } catch (e) { console.error(e); }
        }

        // دالة عرض التفاصيل أسفل الكروت ببيانات السيرفر الحقيقية
        async function showDetails(type) {
            const panel = document.getElementById('detailsPanel');
            const title = document.getElementById('detailsTitle');
            const content = document.getElementById('detailsContent');
            
            panel.style.display = 'block';
            content.innerHTML = '<p style="text-align:center; color:var(--gold-primary);">جاري تحميل البيانات الحية...</p>'; 

            try {
                if(type === 'orders') {
                    title.innerHTML = '<i class="fa-solid fa-clock-rotate-left"></i> الطلبات المعلقة (قيد المراجعة)';
                    const res = await fetch(`/api/admin/orders?adminPass=${currentPin}`);
                    const orders = await res.json();
                    
                    // تصفية الطلبات لعرض ذات الحالة "قيد المراجعة" فقط
                    const pendingOrders = orders.filter(o => o.status.includes('قيد المراجعة'));

                    if(pendingOrders.length > 0) {
                        content.innerHTML = '';
                        pendingOrders.forEach(order => {
                            // تجميع تفاصيل السلة
                            let itemsText = order.items.map(i => `${i.name || 'منتج'} (الكمية: ${i.qty || 1})`).join('، ');
                            content.innerHTML += `
                                <div class="data-item" id="order-${order.id}">
                                    <div class="data-header">
                                        <span>هاتف العميل: ${order.phone}</span>
                                        <span style="color:var(--gold-primary)">YER ${order.total}</span>
                                    </div>
                                    <div class="data-body">
                                        <strong>الفاتورة:</strong> ${order.id}<br>
                                        <strong>المنتجات:</strong> ${itemsText}<br>
                                        <strong>التاريخ:</strong> ${order.date}
                                    </div>
                                    <div class="actions-row">
                                        <button class="btn-status btn-accept" onclick="updateOrderStatus('${order.id}', 'مكتمل ✅')">✅ قبول وشحن</button>
                                        <button class="btn-status btn-cancel" onclick="updateOrderStatus('${order.id}', 'ملغي ❌')">❌ إلغاء</button>
                                    </div>
                                </div>
                            `;
                        });
                    } else {
                        content.innerHTML = '<p style="text-align:center; padding: 10px;">🎉 لا توجد طلبات معلقة حالياً!</p>';
                    }
                } 
                else if(type === 'products') {
                    title.innerHTML = '<i class="fa-solid fa-box-open"></i> قائمة المنتجات';
                    const res = await fetch(`/api/admin/products?adminPass=${currentPin}`);
                    const products = await res.json();
                    
                    content.innerHTML = '';
                    products.slice(0, 15).forEach(prod => { // عرض أول 15 منتج للتجربة والسرعة
                        content.innerHTML += `
                            <div class="data-item">
                                <div class="data-header"><span>${prod.name}</span><span style="color:var(--gold-primary)">YER ${prod.price}</span></div>
                                <div class="data-body">القسم: ${prod.cat}</div>
                            </div>
                        `;
                    });
                }
                else if(type === 'users') {
                    title.innerHTML = '<i class="fa-solid fa-users"></i> المستخدمين المسجلين';
                    const res = await fetch(`/api/admin/users?adminPass=${currentPin}`);
                    const users = await res.json();
                    
                    content.innerHTML = '';
                    users.forEach(user => {
                        content.innerHTML += `
                            <div class="data-item">
                                <div class="data-header"><span>الاسم: ${user.name}</span><span style="color:var(--gold-primary)">رصيد: ${user.balance} YER</span></div>
                                <div class="data-body">الهاتف: ${user.phone} | انضم: ${user.joinDate}</div>
                            </div>
                        `;
                    });
                }
                else if(type === 'categories') {
                    title.innerHTML = '<i class="fa-solid fa-layer-group"></i> الأقسام المتوفرة';
                    const res = await fetch(`/api/admin/categories?adminPass=${currentPin}`);
                    const cats = await res.json();
                    
                    content.innerHTML = '';
                    cats.forEach(cat => {
                        content.innerHTML += `
                            <div class="data-item">
                                <strong>القسم:</strong> ${cat.name} ${cat.sub ? `| فرعي: ${cat.sub}` : ''}
                            </div>
                        `;
                    });
                }
            } catch (error) {
                content.innerHTML = '<p style="text-align:center; color:red;">حدث خطأ أثناء جلب البيانات السحابية.</p>';
            }
            
            panel.scrollIntoView({ behavior: 'smooth' });
        }

        // دالة تحديث حالة الطلب حقيقياً بالسيرفر السحابي
        async function updateOrderStatus(orderId, newStatus) {
            try {
                const response = await fetch('/api/admin/orders/update-status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ adminPass: currentPin, id: orderId, status: newStatus })
                });
                const data = await response.json();
                
                if(data.success) {
                    const item = document.getElementById(`order-${orderId}`);
                    item.style.transition = 'all 0.4s ease';
                    item.style.opacity = '0';
                    setTimeout(() => {
                        item.remove();
                        refreshStats();
                    }, 400);
                } else {
                    alert("فشل في تحديث حالة الطلب.");
                }
            } catch (e) {
                alert("حدث خطأ في الاتصال بالسيرفر.");
            }
        }

        // أزرار العمليات المباشرة للإضافة
        function addNewProduct() {
            const name = prompt("أدخل اسم المنتج الجديد:");
            const price = prompt("أدخل السعر بالريال اليمني:");
            const cat = prompt("أدخل اسم القسم (مثال: مواد غذائية):");
            if(!name || !price || !cat) return;

            fetch('/api/admin/products/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ adminPass: currentPin, name, price, cat })
            }).then(r => r.json()).then(res => {
                if(res.success) { alert("تمت إضافة المنتج بنجاح! 🎉"); refreshStats(); }
                else { alert("فشلت الإضافة!"); }
            });
        }

        function addNewCategory() {
            const name = prompt("أدخل اسم القسم الجديد:");
            if(!name) return;

            fetch('/api/admin/category/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ adminPass: currentPin, name })
            }).then(r => r.json()).then(res => {
                if(res.success) { alert("تمت إضافة القسم بنجاح! 🎉"); refreshStats(); }
                else { alert("فشلت الإضافة!"); }
            });
        }
    </script>
</body>
</html>

