<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة تحكم تموينات أبو حسين 🛒</title>
    <!-- Bootstrap CSS متناسق وتجاوب رائع مع الهواتف -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .sidebar {
            background-color: #1e272e;
            color: white;
            min-height: 100vh;
        }
        .sidebar .nav-link {
            color: #d2dae2;
            margin-bottom: 8px;
            border-radius: 6px;
            font-size: 0.95rem;
            transition: all 0.3s;
        }
        .sidebar .nav-link.active, .sidebar .nav-link:hover {
            background-color: #05c46b;
            color: white;
            font-weight: bold;
        }
        .card-counter {
            border-right: 5px solid #05c46b;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            border-radius: 10px;
        }
        .table-container {
            background: white;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }
        .product-img {
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid #ddd;
        }
    </style>
</head>
<body>

<div class="container-fluid">
    <div class="row">
        <!-- 📱 القائمة الجانبية للتنقل -->
        <nav class="col-md-3 col-lg-2 d-md-block sidebar collapse p-3">
            <div class="text-center py-4 border-bottom border-secondary mb-3">
                <h4 class="text-white fw-bold"><i class="fa-solid fa-store me-2"></i> أبو حسين</h4>
                <small class="text-muted">نظام الإدارة الشامل</small>
            </div>
            <div class="nav flex-column nav-pills" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                <button class="nav-link active text-start" id="v-pills-dash-tab" data-bs-toggle="pill" data-bs-target="#v-pills-dash" type="button" role="tab" onclick="fetchStats()"><i class="fa-solid fa-chart-line me-2"></i> الإحصائيات</button>
                <button class="nav-link text-start" id="v-pills-products-tab" data-bs-toggle="pill" data-bs-target="#v-pills-products" type="button" role="tab" onclick="fetchProducts()"><i class="fa-solid fa-box me-2"></i> المنتجات</button>
                <button class="nav-link text-start" id="v-pills-orders-tab" data-bs-toggle="pill" data-bs-target="#v-pills-orders" type="button" role="tab" onclick="fetchOrders()"><i class="fa-solid fa-file-invoice-dollar me-2"></i> الطلبات</button>
                <button class="nav-link text-start" id="v-pills-users-tab" data-bs-toggle="pill" data-bs-target="#v-pills-users" type="button" role="tab" onclick="fetchUsers()"><i class="fa-solid fa-users me-2"></i> المستخدمين</button>
                <button class="nav-link text-start" id="v-pills-txns-tab" data-bs-toggle="pill" data-bs-target="#v-pills-txns" type="button" role="tab" onclick="fetchTransactions()"><i class="fa-solid fa-gamepad me-2"></i> شحن الألعاب</button>
            </div>
        </nav>

        <!-- 🖥️ ساحة عرض البيانات -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
            
            <!-- تنبيه حماية في أعلى الصفحة -->
            <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded shadow-sm">
                <h1 class="h3 mb-0">لوحة تحكم التطبيق</h1>
                <div class="d-flex align-items-center">
                    <label class="me-2 text-nowrap">رمز الإدارة السري:</label>
                    <input type="password" id="admin-pass" class="form-control form-control-sm" style="width: 150px;" value="123456" onchange="initDashboard()">
                </div>
            </div>

            <div class="tab-content" id="v-pills-tabContent">
                
                <!-- 📊 1. قسم الإحصائيات -->
                <div class="tab-pane fade show active" id="v-pills-dash" role="tabpanel">
                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <div class="card p-3 card-counter bg-white">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted">إجمالي المنتجات</h6>
                                        <h3 id="count-products" class="fw-bold">0</h3>
                                    </div>
                                    <i class="fa-solid fa-box fa-2x text-success"></i>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card p-3 card-counter bg-white" style="border-right-color: #ff9f43;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted">الطلبات المعلقة</h6>
                                        <h3 id="count-orders" class="fw-bold">0</h3>
                                    </div>
                                    <i class="fa-solid fa-clock fa-2x text-warning"></i>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card p-3 card-counter bg-white" style="border-right-color: #54a0ff;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted">إجمالي المستخدمين</h6>
                                        <h3 id="count-users" class="fw-bold">0</h3>
                                    </div>
                                    <i class="fa-solid fa-users fa-2x text-info"></i>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card p-3 card-counter bg-white" style="border-right-color: #10ac84;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted">إجمالي الأقسام</h6>
                                        <h3 id="count-cats" class="fw-bold">0</h3>
                                    </div>
                                    <i class="fa-solid fa-tags fa-2x text-teal"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 📦 2. إدارة المنتجات -->
                <div class="tab-pane fade" id="v-pills-products" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h2 class="h4">إدارة المنتجات المتوفرة</h2>
                        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addProductModal"><i class="fa-solid fa-plus me-1"></i> إضافة منتج جديد</button>
                    </div>
                    <div class="table-container">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>الصورة</th>
                                        <th>الاسم</th>
                                        <th>السعر (YER)</th>
                                        <th>القسم</th>
                                        <th>التحكم</th>
                                    </tr>
                                </thead>
                                <tbody id="products-table-body"></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- 📝 3. إدارة الطلبات للعملاء -->
                <div class="tab-pane fade" id="v-pills-orders" role="tabpanel">
                    <h2 class="h4 mb-4">طلبات الشراء ومراجعتها</h2>
                    <div class="table-container">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>رقم الفاتورة</th>
                                        <th>رقم هاتف العميل</th>
                                        <th>القيمة الإجمالية</th>
                                        <th>حالة الطلب الحالي</th>
                                        <th>التاريخ والوقت</th>
                                        <th>تحديث الحالة</th>
                                    </tr>
                                </thead>
                                <tbody id="orders-table-body"></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- 👥 4. إدارة رصيد المستخدمين -->
                <div class="tab-pane fade" id="v-pills-users" role="tabpanel">
                    <h2 class="h4 mb-4">حسابات العملاء وشحن الرصيد الفوري</h2>
                    <div class="table-container">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>الاسم</th>
                                        <th>الهاتف</th>
                                        <th>الرصيد المتوفر</th>
                                        <th>تاريخ الانضمام</th>
                                        <th>تعديل الرصيد فورا</th>
                                        <th>حذف</th>
                                    </tr>
                                </thead>
                                <tbody id="users-table-body"></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- 🕹️ 5. العمليات المالية وشحن الألعاب -->
                <div class="tab-pane fade" id="v-pills-txns" role="tabpanel">
                    <h2 class="h4 mb-4">سجل عمليات شحن الألعاب (ميجا سنتر)</h2>
                    <div class="table-container">
                        <div class="table-responsive">
                            <table class="table table-dark table-striped table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>المرجع</th>
                                        <th>رقم المشترك</th>
                                        <th>معرف اللاعب (ID)</th>
                                        <th>الخدمة المطلوبة</th>
                                        <th>السعر</th>
                                        <th>حالة العملية</th>
                                        <th>التاريخ والوقت</th>
                                    </tr>
                                </thead>
                                <tbody id="txns-table-body"></tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </main>
    </div>
</div>

<!-- مودال إضافة منتج جديد -->
<div class="modal fade" id="addProductModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">إضافة منتج جديد للتموينات</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="addProductForm" onsubmit="saveProduct(event)">
            <div class="mb-3">
                <label class="form-label">اسم المنتج</label>
                <input type="text" class="form-control" id="prod-name" required>
            </div>
            <div class="mb-3">
                <label class="form-label">السعر (YER)</label>
                <input type="number" class="form-control" id="prod-price" required>
            </div>
            <div class="mb-3">
                <label class="form-label">رابط الصورة (URL)</label>
                <input type="url" class="form-control" id="prod-img">
            </div>
            <div class="mb-3">
                <label class="form-label">القسم</label>
                <input type="text" class="form-control" id="prod-cat" placeholder="مثال: مواد غذائية" required>
            </div>
            <button type="submit" class="btn btn-success w-100">حفظ المنتج في السحاب ☁️</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function getAdminPass() {
        return document.getElementById('admin-pass').value;
    }

    // 1. جلب الإحصائيات الحقيقية
    async function fetchStats() {
        try {
            const res = await fetch(`/api/admin/stats?adminPass=${getAdminPass()}`);
            if(!res.ok) throw new Error("غير مصرح");
            const data = await res.json();
            document.getElementById('count-products').innerText = data.productsCount;
            document.getElementById('count-orders').innerText = data.pendingOrders;
            document.getElementById('count-users').innerText = data.usersCount;
            document.getElementById('count-cats').innerText = data.categoriesCount;
        } catch (err) { alert("فشل الاتصال: تأكد من كتابة رمز الإدارة السري بشكل صحيح!"); }
    }

    // 2. جلب المنتجات السحابية الحقيقية
    async function fetchProducts() {
        try {
            const res = await fetch(`/api/admin/products?adminPass=${getAdminPass()}`);
            const products = await res.json();
            const tbody = document.getElementById('products-table-body');
            tbody.innerHTML = '';
            products.forEach(p => {
                tbody.innerHTML += `
                    <tr>
                        <td><img class="product-img" src="${p.img || 'https://via.placeholder.com/50'}" onerror="this.src='https://via.placeholder.com/50'"></td>
                        <td class="fw-bold">${p.name}</td>
                        <td><span class="badge bg-success">${p.price} YER</span></td>
                        <td><span class="badge bg-secondary">${p.cat}</span></td>
                        <td>
                            <button class="btn btn-danger btn-sm" onclick="deleteProduct('${p._id}')"><i class="fa-solid fa-trash"></i></button>
                        </td>
                    </tr>
                `;
            });
        } catch (err) { console.error(err); }
    }

    // 3. إضافة منتج حقيقي للسحاب
    async function saveProduct(event) {
        event.preventDefault();
        const name = document.getElementById('prod-name').value;
        const price = document.getElementById('prod-price').value;
        const image = document.getElementById('prod-img').value;
        const cat = document.getElementById('prod-cat').value;

        try {
            const res = await fetch('/api/admin/products/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ adminPass: getAdminPass(), name, price, image, cat })
            });
            const data = await res.json();
            if(data.success) {
                alert("تم إضافة وحفظ المنتج بنجاح! 🎉");
                document.getElementById('addProductForm').reset();
                bootstrap.Modal.getInstance(document.getElementById('addProductModal')).hide();
                fetchProducts();
                fetchStats();
            }
        } catch(err) { alert("حدث خطأ أثناء إضافة المنتج"); }
    }

    // 4. حذف منتج من السحاب
    async function deleteProduct(id) {
        if(!confirm("هل تريد بالفعل إزالة هذا المنتج نهائياً من قاعدة البيانات؟")) return;
        try {
            const res = await fetch('/api/admin/products/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ adminPass: getAdminPass(), id })
            });
            const data = await res.json();
            if(data.success) {
                alert("تم الحذف بنجاح!");
                fetchProducts();
                fetchStats();
            }
        } catch (err) { console.error(err); }
    }

    // 5. جلب المستخدمين وإدارة الرصيد الحقيقي
    async function fetchUsers() {
        try {
            const res = await fetch(`/api/admin/users?adminPass=${getAdminPass()}`);
            const users = await res.json();
            const tbody = document.getElementById('users-table-body');
            tbody.innerHTML = '';
            users.forEach(u => {
                tbody.innerHTML += `
                    <tr>
                        <td class="fw-bold">${u.name}</td>
                        <td>${u.phone}</td>
                        <td class="text-success fw-bold">${u.balance} YER</td>
                        <td><small>${u.joinDate}</small></td>
                        <td>
                            <div class="input-group input-group-sm" style="max-width: 220px;">
                                <input type="number" class="form-control" id="bal-${u.phone}" placeholder="المبلغ الجديد">
                                <button class="btn btn-success" onclick="updateUserBalance('${u.phone}')">شحن/تعديل</button>
                            </div>
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger" onclick="deleteUser('${u.id}')"><i class="fa-solid fa-user-minus"></i></button>
                        </td>
                    </tr>
                `;
            });
        } catch (err) { console.error(err); }
    }

    // 6. شحن حساب المستخدم
    async function updateUserBalance(phone) {
        const val = document.getElementById(`bal-${phone}`).value;
        if(!val) return alert("فضلاً ضع قيمة الرصيد أولاً!");
        try {
            const res = await fetch('/api/admin/user/update-balance', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ adminPass: getAdminPass(), phone, newBalance: val })
            });
            const data = await res.json();
            if(data.success) {
                alert(`تم تحديث رصيد الحساب (${phone}) إلى ${val} YER بنجاح وإشعار العميل! 💰`);
                fetchUsers();
            }
        } catch (err) { console.error(err); }
    }

    // 7. حذف مستخدم بالكامل
    async function deleteUser(id) {
        if(!confirm("احذر! هل تود حذف هذا العميل نهائياً من السيستم؟")) return;
        try {
            const res = await fetch('/api/admin/users/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ adminPass: getAdminPass(), id })
            });
            const data = await res.json();
            if(data.success) {
                alert("تم الحذف.");
                fetchUsers();
                fetchStats();
            }
        } catch (err) { console.error(err); }
    }

    // 8. جلب الطلبات ومراجعتها
    async function fetchOrders() {
        try {
            const res = await fetch(`/api/admin/orders?adminPass=${getAdminPass()}`);
            const orders = await res.json();
            const tbody = document.getElementById('orders-table-body');
            tbody.innerHTML = '';
            orders.forEach(o => {
                let itemsList = o.items.map(i => `${i.name} (${i.qty || 1})`).join('، ');
                tbody.innerHTML += `
                    <tr>
                        <td><strong>${o.id}</strong></td>
                        <td>${o.phone}</td>
                        <td class="text-success fw-bold">${o.total} YER</td>
                        <td><span class="badge bg-info">${o.status}</span></td>
                        <td><small>${o.date}</small></td>
                        <td>
                            <select class="form-select form-select-sm" onchange="updateOrderStatus('${o.id}', this.value)">
                                <option value="">تحديث الحالة...</option>
                                <option value="قيد المراجعة ⏳">قيد المراجعة</option>
                                <option value="جاري التوصيل 🚚">جاري التوصيل</option>
                                <option value="مكتمل ✅">مكتمل</option>
                                <option value="ملغي ❌">ملغي</option>
                            </select>
                        </td>
                    </tr>
                `;
            });
        } catch (err) { console.error(err); }
    }

    // 9. تحديث حالة الفواتير وإرسال إشعار فوري للعميل
    async function updateOrderStatus(id, status) {
        if(!status) return;
        try {
            const res = await fetch('/api/admin/orders/update-status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ adminPass: getAdminPass(), id, status })
            });
            const data = await res.json();
            if(data.success) {
                alert("تم تعديل الحالة وإرسال إشعار تحديث الطلب بنجاح!");
                fetchOrders();
                fetchStats();
            }
        } catch (err) { console.error(err); }
    }

    // 10. جلب العمليات المالية لشحن الألعاب
    async function fetchTransactions() {
        try {
            const res = await fetch(`/api/admin/transactions?adminPass=${getAdminPass()}`);
            const txns = await res.json();
            const tbody = document.getElementById('txns-table-body');
            tbody.innerHTML = '';
            txns.forEach(t => {
                tbody.innerHTML += `
                    <tr>
                        <td><small>${t.referenceId}</small></td>
                        <td>${t.phone}</td>
                        <td><strong class="text-warning">${t.targetId}</strong></td>
                        <td>${t.serviceName}</td>
                        <td class="text-success">${t.price} YER</td>
                        <td><span class="badge ${t.status.includes('ناجحة') ? 'bg-success' : 'bg-danger'}">${t.status}</span></td>
                        <td><small>${t.date}</small></td>
                    </tr>
                `;
            });
        } catch (err) { console.error(err); }
    }

    function initDashboard() {
        fetchStats();
    }

    window.onload = initDashboard;
</script>
</body>
</html>

