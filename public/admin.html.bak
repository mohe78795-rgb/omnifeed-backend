<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة تحكم أبو حسين المركزية</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
    <style>*{font-family:'Cairo',sans-serif;}</style>
</head>
<body class="bg-[#05070a] text-slate-100 min-h-screen pb-20">

    <!-- شاشة قفل لوحة التحكم -->
    <div id="admin-lock" class="fixed inset-0 z-[4000] bg-[#05070a] flex items-center justify-center p-6">
        <div class="max-w-md w-full bg-slate-900/40 p-8 rounded-3xl border border-white/5 space-y-6 text-center">
            <h2 class="text-2xl font-black text-emerald-400">منظومة الإدارة المركزية</h2>
            <input type="password" id="admin-key-input" class="w-full p-4 bg-black/60 border border-white/5 rounded-xl text-center font-black text-emerald-500 text-lg outline-none" placeholder="أدخل الرمز السري الفوقي">
            <button onclick="loginAdmin()" class="w-full bg-emerald-500 text-black font-black py-4 rounded-xl shadow-lg shadow-emerald-500/10 active:scale-95 transition">ولوج آمن للسيرفر</button>
        </div>
    </div>

    <!-- لوحة التحكم الرئيسية -->
    <div id="admin-content" class="hidden max-w-4xl mx-auto px-6 pt-10 space-y-8">
        <header class="flex justify-between items-center border-b border-white/5 pb-6">
            <div>
                <h1 class="text-3xl font-black text-emerald-400">لوحة تحكم أبو حسين</h1>
                <p class="text-xs text-slate-400 mt-1">إدارة الطلبات، الحسابات، والنظام البريد البرقي والمراسلات</p>
            </div>
            <button onclick="location.reload()" class="bg-white/5 px-4 py-2 rounded-xl text-xs border border-white/5 font-bold">تحديث البيانات</button>
        </header>

        <!-- التبويبات العلوية لإدارة اللوحة -->
        <div class="flex gap-2 overflow-x-auto pb-2">
            <button onclick="switchTab('orders')" id="tab-orders" class="bg-emerald-500 text-black px-5 py-2.5 rounded-xl text-xs font-black shrink-0">📦 الطلبات والعمليات</button>
            <button onclick="switchTab('users')" id="tab-users" class="bg-white/5 text-slate-400 px-5 py-2.5 rounded-xl text-xs font-black shrink-0">👥 إدارة المحافظ</button>
            <button onclick="switchTab('messages')" id="tab-messages" class="bg-white/5 text-slate-400 px-5 py-2.5 rounded-xl text-xs font-black shrink-0">📢 إرسال إشعار برقي</button>
            <button onclick="switchTab('settings')" id="tab-settings" class="bg-white/5 text-slate-400 px-5 py-2.5 rounded-xl text-xs font-black shrink-0">⚙️ إضافة خدمات وفيديو</button>
        </div>

        <!-- 1️⃣ تبويب الطلبات والعمليات -->
        <div id="panel-orders" class="admin-panel space-y-4">
            <h3 class="font-black text-lg">سجل طلبات الفواتير الحالية</h3>
            <div id="adm-orders-list" class="space-y-3"></div>
        </div>

        <!-- 2️⃣ تبويب إدارة المحافظ والشحن -->
        <div id="panel-users" class="admin-panel hidden space-y-4">
            <h3 class="font-black text-lg">قائمة مستخدمي المنظومة ومحفظتهم</h3>
            <div id="adm-users-list" class="space-y-3"></div>
        </div>

        <!-- 3️⃣ تبويب نظام المراسلة والإشعارات الجديد -->
        <div id="panel-messages" class="admin-panel hidden space-y-6">
            <div class="bg-slate-900/30 p-6 rounded-3xl border border-white/5 max-w-lg space-y-4">
                <h3 class="font-black text-lg text-emerald-400">📢 إرسال رسالة وإشعار دفع (Push Notification)</h3>
                <div class="space-y-1">
                    <label class="text-xs text-slate-400">نوع المستلم:</label>
                    <select id="msg-receiver-type" class="w-full p-3.5 bg-black/60 border border-white/5 rounded-xl text-sm outline-none text-white">
                        <option value="ALL">للجميع (إشعار وعرض عام لكافة المستخدمين)</option>
                        <option value="INDIVIDUAL">لمستخدم محدد (عبر رقم هاتف حسابه)</option>
                    </select>
                </div>
                <div id="msg-phone-container" class="space-y-1 hidden">
                    <label class="text-xs text-slate-400">رقم هاتف العميل المستهدف:</label>
                    <input type="tel" id="msg-phone" class="w-full p-3.5 bg-black/60 border border-white/5 rounded-xl text-sm text-white outline-none" placeholder="7xxxxxxxx">
                </div>
                <div class="space-y-1">
                    <label class="text-xs text-slate-400">عنوان الإشعار:</label>
                    <input type="text" id="msg-title" class="w-full p-3.5 bg-black/60 border border-white/5 rounded-xl text-sm text-white outline-none" placeholder="أدخل عنواناً جذاباً...">
                </div>
                <div class="space-y-1">
                    <label class="text-xs text-slate-400">نص الرسالة التفصيلي:</label>
                    <textarea id="msg-body" class="w-full p-3.5 bg-black/60 border border-white/5 rounded-xl text-sm text-white outline-none h-32" placeholder="اكتب تفاصيل العرض أو التنبيه هنا..."></textarea>
                </div>
                <button onclick="sendAdminMessage()" class="w-full bg-emerald-500 text-black font-black py-4 rounded-xl text-sm shadow-xl active:scale-95 transition">بث وإرسال الإشعار فوراً</button>
            </div>
        </div>

        <!-- 4️⃣ تبويب الإعدادات وإضافة الفئات والمنتجات والفيديو -->
        <div id="panel-settings" class="admin-panel hidden grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-slate-900/20 p-6 rounded-3xl border border-white/5 space-y-3">
                <h4 class="font-black text-sm text-emerald-400">🎬 تحديث الفيديو الإعلاني الترويجي الأعلى</h4>
                <input type="text" id="set-ad-url" class="w-full p-3 bg-black/50 border border-white/5 rounded-xl text-xs" placeholder="رابط فيديو يوتيوب Embed">
                <button onclick="addAd()" class="w-full bg-emerald-500 text-black font-black py-2.5 rounded-xl text-xs">حفظ وتحديث الفيديو</button>
            </div>
            <div class="bg-slate-900/20 p-6 rounded-3xl border border-white/5 space-y-3">
                <h4 class="font-black text-sm text-emerald-400">📁 إضافة قسم/فئة جديدة</h4>
                <input type="text" id="cat-name" class="w-full p-3 bg-black/50 border border-white/5 rounded-xl text-xs" placeholder="اسم القسم">
                <input type="text" id="cat-sub" class="w-full p-3 bg-black/50 border border-white/5 rounded-xl text-xs" placeholder="الوصف الفرعي">
                <input type="text" id="cat-img" class="w-full p-3 bg-black/50 border border-white/5 rounded-xl text-xs" placeholder="رابط صورة القسم">
                <button onclick="addCategory()" class="w-full bg-emerald-500 text-black font-black py-2.5 rounded-xl text-xs">إنشاء القسم</button>
            </div>
            <div class="bg-slate-900/20 p-6 rounded-3xl border border-white/5 space-y-3 md:col-span-2">
                <h4 class="font-black text-sm text-emerald-400">🛍️ إضافة منتج جديد تحت قسم محدد</h4>
                <input type="text" id="p-name" class="w-full p-3 bg-black/50 border border-white/5 rounded-xl text-xs" placeholder="اسم منتج الخدمة">
                <input type="number" id="p-price" class="w-full p-3 bg-black/50 border border-white/5 rounded-xl text-xs" placeholder="السعر بالريال اليمني YER">
                <input type="text" id="p-img" class="w-full p-3 bg-black/50 border border-white/5 rounded-xl text-xs" placeholder="رابط الصورة التوضيحية">
                <input type="text" id="p-cat" class="w-full p-3 bg-black/50 border border-white/5 rounded-xl text-xs" placeholder="اسم القسم المطابق تماماً لتتبعه">
                <button onclick="addProduct()" class="w-full bg-emerald-500 text-black font-black py-3 rounded-xl text-xs">تثبيت المنتج في السيرفر</button>
            </div>
        </div>
    </div>

    <script>
        const API = window.location.origin;
        let masterKey = "";

        document.getElementById('msg-receiver-type').addEventListener('change', function() {
            document.getElementById('msg-phone-container').classList.toggle('hidden', this.value === 'ALL');
        });

        async function loginAdmin() {
            const key = document.getElementById('admin-key-input').value;
            if(!key) return alert("أدخل المفتاح السري أولاً");
            masterKey = key;
            await loadDashboard();
        }

        async function loadDashboard() {
            let res = await fetch(`${API}/api/admin/dashboard`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ adminPass: masterKey })
            });
            let reply = await res.json();
            if(reply.success) {
                document.getElementById('admin-lock').classList.add('hidden');
                document.getElementById('admin-content').classList.remove('hidden');
                renderAdminData(reply.data);
            } else {
                alert("❌ الرمز السري غير صحيح الفوقي لا يمتلك صلاحية الكود المصدري");
            }
        }

        function renderAdminData(data) {
            const oList = document.getElementById('adm-orders-list');
            oList.innerHTML = data.orders.map(o => `
                <div class="p-5 bg-white/5 rounded-2xl border border-white/5 flex flex-col md:flex-row justify-between md:items-center gap-4">
                    <div>
                        <div class="flex items-center gap-3"><span class="font-black text-emerald-400">${o.id}</span><span class="text-[10px] text-slate-400">📞 ${o.phone}</span></div>
                        <div class="text-xs text-slate-300 mt-2">${o.items.map(i=>`${i.name} (x${i.qty})`).join(' | ')}</div>
                        <p class="text-[9px] text-slate-500 mt-1">${o.date} - <b class="text-emerald-500">${o.total.toLocaleString()} YER</b></p>
                    </div>
                    <div class="flex gap-2">
                        <button onclick="updateStatus('${o.id}', 'مكتمل ✅')" class="bg-emerald-500 text-black px-3 py-1.5 rounded-lg text-xs font-bold">اعتماد كـ مكتمل</button>
                        <button onclick="updateStatus('${o.id}', 'مرفوض ❌')" class="bg-red-500/20 text-red-400 border border-red-500/30 px-3 py-1.5 rounded-lg text-xs font-bold">رفض الطلب</button>
                    </div>
                </div>
            `).join('');

            const uList = document.getElementById('adm-users-list');
            uList.innerHTML = data.users.map(u => `
                <div class="p-4 bg-white/5 rounded-2xl border border-white/5 flex justify-between items-center">
                    <div>
                        <h4 class="font-black text-sm">${u.name}</h4>
                        <p class="text-xs text-slate-400 mt-0.5">📞 ${u.phone} | 💰 <span class="text-emerald-400 font-bold">${u.bal.toLocaleString()} YER</span></p>
                    </div>
                    <button onclick="promptBalance('${u.phone}', ${u.bal})" class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-3 py-1.5 rounded-xl text-xs font-black">شحن وتعديل المحفظة</button>
                </div>
            `).join('');
        }

        async function updateStatus(id, status) {
            await fetch(`${API}/api/admin/order/update-status`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ adminPass: masterKey, id, status })
            });
            await loadDashboard();
        }

        async function promptBalance(phone, currentBal) {
            const amount = prompt(`الرصيد الحالي: ${currentBal} YER\nأدخل الرصيد الإجمالي الجديد الكلي المستهدف للمحفظة:`);
            if(!amount || isNaN(amount)) return;
            let res = await fetch(`${API}/api/admin/user/update-balance`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ adminPass: masterKey, phone, newBalance: Number(amount) })
            });
            if(res.ok) { alert("✅ تم تحديث محفظة العميل وإرسال إشعار فوري له!"); await loadDashboard(); }
        }

        async function sendAdminMessage() {
            const type = document.getElementById('msg-receiver-type').value;
            const receiver = type === 'ALL' ? 'ALL' : document.getElementById('msg-phone').value;
            const title = document.getElementById('msg-title').value;
            const body = document.getElementById('msg-body').value;

            if(!title || !body || (type !== 'ALL' && !receiver)) return alert("⚠️ يرجى ملء حقول الإشعار البرقي بالكامل!");

            let res = await fetch(`${API}/api/messages/send`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ adminPass: masterKey, receiver, title, body })
            });
            if(res.ok) {
                alert("✅ تم بث وإرسال الإشعار بنجاح عبر السيرفر والفايربيس!");
                document.getElementById('msg-title').value = "";
                document.getElementById('msg-body').value = "";
            } else { alert("❌ فشل الإرسال"); }
        }

        async function addCategory() {
            const name = document.getElementById('cat-name').value;
            const sub = document.getElementById('cat-sub').value;
            const img = document.getElementById('cat-img').value;
            await fetch(`${API}/api/admin/category/add`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ adminPass: masterKey, name, sub, img })
            });
            alert("✅ أضيف القسم"); loadDashboard();
        }

        async function addProduct() {
            const name = document.getElementById('p-name').value;
            const price = document.getElementById('p-price').value;
            const img = document.getElementById('p-img').value;
            const cat = document.getElementById('p-cat').value;
            await fetch(`${API}/api/admin/product/add`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ adminPass: masterKey, name, price, img, cat })
            });
            alert("✅ أضيف المنتج لبنية الخدمات"); loadDashboard();
        }

        async function addAd() {
            const videoUrl = document.getElementById('set-ad-url').value;
            await fetch(`${API}/api/admin/ad/add`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ adminPass: masterKey, videoUrl })
            });
            alert("✅ تم تحديث الفيديو الإعلاني بنجاح الفوري");
        }

        function switchTab(tabId) {
            document.querySelectorAll('.admin-panel').forEach(p => p.classList.add('hidden'));
            document.querySelectorAll('[id^="tab-"]').forEach(b => b.classList.replace('bg-emerald-500', 'bg-white/5'));
            document.querySelectorAll('[id^="tab-"]').forEach(b => b.classList.replace('text-black', 'text-slate-400'));

            document.getElementById(`panel-${tabId}`).classList.remove('hidden');
            document.getElementById(`tab-${tabId}`).classList.replace('bg-white/5', 'bg-emerald-500');
            document.getElementById(`tab-${tabId}`).classList.replace('text-slate-400', 'text-black');
        }
    </script>
</body>
</html>
