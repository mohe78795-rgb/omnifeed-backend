<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة تحكم أبو حسين المركزية</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Cairo', sans-serif; }
        ::-webkit-scrollbar { display: none; }
    </style>
</head>
<body class="bg-[#05070a] text-slate-100 min-h-screen pb-20">

    <audio id="snd-order-alert" src="https://assets.mixkit.co/active_storage/sfx/911/911-preview.mp3" preload="auto"></audio>
    <audio id="snd-success" src="https://assets.mixkit.co/active_storage/sfx/1435/1435-preview.mp3" preload="auto"></audio>

    <div id="adm-toast" class="fixed top-6 left-6 right-6 z-[5000] bg-emerald-500 text-black font-black p-5 rounded-2xl text-sm text-center shadow-2xl hidden"></div>

    <header class="bg-slate-950/80 backdrop-blur-md border-b border-white/5 p-6 sticky top-0 z-50 flex justify-between items-center">
        <div>
            <h1 class="font-black text-base text-emerald-400">لوحة تحكم تموينات أبو حسين</h1>
            <p class="text-[10px] text-slate-500 font-bold mt-0.5">منظومة الإدارة المركزية والتحكم السحابي</p>
        </div>
        <div class="flex gap-2">
            <input type="password" id="master-key" class="bg-black/60 border border-white/10 rounded-xl px-4 py-2 text-xs text-center font-black text-emerald-400 outline-none w-32 placeholder-slate-600" placeholder="رمز الأدمن">
            <button onclick="refreshDashboard()" class="w-9 h-9 bg-emerald-500 text-black rounded-xl flex items-center justify-center active:scale-90 transition"><i class="fas fa-sync-alt text-xs"></i></button>
        </div>
    </header>

    <nav class="flex gap-2 overflow-x-auto px-6 mt-6 scrollbar-none">
        <button id="tab-orders" onclick="switchTab('orders')" class="bg-emerald-500 text-black px-5 py-3 rounded-xl font-black text-xs shrink-0 transition">🧾 الفواتير والطلبات</button>
        <button id="tab-messages" onclick="switchTab('messages')" class="bg-white/5 text-slate-400 px-5 py-3 rounded-xl font-black text-xs shrink-0 transition">📥 رسائل العملاء</button>
        <button id="tab-users" onclick="switchTab('users')" class="bg-white/5 text-slate-400 px-5 py-3 rounded-xl font-black text-xs shrink-0 transition">👥 الحسابات والمحافظ</button>
        <button id="tab-store" onclick="switchTab('store')" class="bg-white/5 text-slate-400 px-5 py-3 rounded-xl font-black text-xs shrink-0 transition">🛍️ إدارة المنتجات</button>
    </nav>

    <main class="px-6 mt-6">

        <div id="panel-orders" class="admin-panel space-y-4">
            <h2 class="font-black text-sm text-slate-300">طلبات الشراء وفواتير العميل</h2>
            <div id="admin-orders-list" class="space-y-3">
                <div class="text-center py-8 text-xs text-slate-500 font-bold">يرجى إدخال رمز الأدمن وتحديث البيانات...</div>
            </div>
        </div>

        <div id="panel-messages" class="admin-panel space-y-6 hidden">
            <div class="bg-slate-900/30 p-5 rounded-2xl border border-white/5 space-y-3 text-right">
                <h3 class="font-black text-xs text-emerald-400"><i class="fas fa-paper-plane"></i> إرسال رد أو إشعار برقي لعميل</h3>
                <div class="grid grid-cols-2 gap-2">
                    <input type="text" id="msg-to" class="bg-black/50 border border-white/5 rounded-xl p-3 text-xs outline-none text-right" placeholder="رقم هاتف العميل (أو ALL للكل)">
                    <input type="text" id="msg-title" class="bg-black/50 border border-white/5 rounded-xl p-3 text-xs outline-none text-right" placeholder="عنوان الإشعار">
                </div>
                <textarea id="msg-body" rows="3" class="w-full bg-black/50 border border-white/5 rounded-xl p-3 text-xs outline-none text-right placeholder-slate-600" placeholder="نص الرسالة أو تفاصيل التعبئة الحالية..."></textarea>
                <button onclick="sendAdminMessage()" class="w-full bg-emerald-500 text-black font-black py-3 rounded-xl text-xs active:scale-95 transition">بث الإشعار الفوري</button>
            </div>

            <div class="space-y-3">
                <h3 class="font-black text-xs text-amber-400 flex items-center gap-2"><i class="fas fa-inbox"></i> صندوق الرسائل والطلبات الواردة من العملاء</h3>
                <div id="admin-client-messages" class="space-y-2">
                    <div class="text-center py-6 text-xs text-slate-600 font-bold">لا توجد رسائل واردة حالياً</div>
                </div>
            </div>
        </div>

        <div id="panel-users" class="admin-panel space-y-4 hidden">
            <h2 class="font-black text-sm text-slate-300">الحسابات والمحافظ المسجلة بالسيرفر</h2>
            <div id="admin-users-list" class="space-y-3"></div>
        </div>

        <div id="panel-store" class="admin-panel space-y-6 hidden">
            
            <div class="bg-slate-900/30 p-5 rounded-2xl border border-white/5 space-y-3">
                <h3 class="font-black text-xs text-emerald-400"><i class="fab fa-youtube"></i> تحديث فيديو الإعلان العلوي المحمي</h3>
                <div class="flex gap-2">
                    <input type="text" id="set-ad-url" class="flex-1 bg-black/50 border border-white/5 rounded-xl p-3 text-xs outline-none text-left" placeholder="https://www.youtube.com/watch?v=...">
                    <button onclick="updateAdVideo()" class="bg-emerald-500 text-black font-black px-4 rounded-xl text-xs active:scale-95 transition">حفظ الفيديو</button>
                </div>
            </div>

            <div class="bg-slate-900/30 p-5 rounded-2xl border border-white/5 space-y-3">
                <h3 class="font-black text-xs text-teal-400"><i class="fas fa-folder-plus"></i> إضافة قسم فوري جديد (Category)</h3>
                <div class="grid grid-cols-2 gap-2">
                    <input type="text" id="cat-name" class="bg-black/50 border border-white/5 rounded-xl p-3 text-xs text-right outline-none" placeholder="اسم القسم">
                    <input type="text" id="cat-sub" class="bg-black/50 border border-white/5 rounded-xl p-3 text-xs text-right outline-none" placeholder="الوصف الفرعي">
                </div>
                <input type="text" id="cat-img" class="w-full bg-black/50 border border-white/5 rounded-xl p-3 text-xs text-left outline-none" placeholder="رابط صورة القسم (يدعم بحث وصور جوجل)">
                <button onclick="addCategory()" class="w-full bg-teal-500 text-black font-black py-3 rounded-xl text-xs active:scale-95 transition">إنشاء وتثبيت القسم</button>
            </div>

            <div class="bg-slate-900/30 p-5 rounded-2xl border border-white/5 space-y-3">
                <h3 class="font-black text-xs text-amber-400"><i class="fas fa-box-open"></i> إضافة خدمة أو منتج جديد للمتجر (Product)</h3>
                <div class="grid grid-cols-3 gap-2">
                    <input type="text" id="prod-name" class="bg-black/50 border border-white/5 rounded-xl p-3 text-xs text-right outline-none" placeholder="اسم الخدمة">
                    <input type="number" id="prod-price" class="bg-black/50 border border-white/5 rounded-xl p-3 text-xs text-center outline-none" placeholder="السعر YER">
                    <input type="text" id="prod-cat" class="bg-black/50 border border-white/5 rounded-xl p-3 text-xs text-right outline-none" placeholder="القسم الموجه له">
                </div>
                <input type="text" id="prod-img" class="w-full bg-black/50 border border-white/5 rounded-xl p-3 text-xs text-left outline-none" placeholder="رابط صورة المنتج (انسخ الرابط من جوجل مباشرة)">
                <button onclick="addProduct()" class="w-full bg-amber-500 text-black font-black py-3 rounded-xl text-xs active:scale-95 transition">إضافة ونشر المنتج للمتجر</button>
            </div>

        </div>
    </main>

    <script>
        const API = window.location.origin;

        // دالة جلب ومزامنة كافة بيانات لوحة التحكم المركزية
        async function refreshDashboard() {
            const masterKey = document.getElementById('master-key').value.trim();
            if(!masterKey) return showAdminToast("⚠️ يرجى كتابة الرمز السري للأدمن أولاً!");

            try {
                const res = await fetch(`${API}/api/admin/dashboard`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ adminPass: masterKey })
                });
                const reply = await res.json();
                
                if(reply.success) {
                    renderOrders(reply.data.orders);
                    renderUsers(reply.data.users);
                    renderClientMessages(reply.data.clientMessages);
                    if(reply.data.ads && reply.data.ads.length > 0) {
                        document.getElementById('set-ad-url').value = reply.data.ads[0].videoUrl;
                    }
                    showAdminToast("✅ تم تحديث وجلب البيانات الفورية من السيرفر بنجاح");
                } else {
                    showAdminToast("❌ رمز الأدمن السري الذي أدخلته غير صحيح!");
                }
            } catch(e) { showAdminToast("❌ فشل الاتصال بالسيرفر المركزي"); }
        }

        // رندر الفواتير والطلبات مع تغيير الحالة المباشر
        function renderOrders(orders) {
            const container = document.getElementById('admin-orders-list');
            if(orders.length === 0) { container.innerHTML = '<div class="text-center py-6 text-xs text-slate-600">لا توجد طلبات شراء مسجلة</div>'; return; }
            
            container.innerHTML = orders.map(o => `
                <div class="p-5 bg-white/5 border border-white/5 rounded-2xl text-right space-y-3">
                    <div class="flex justify-between items-center border-b border-white/5 pb-2">
                        <span class="text-[10px] text-slate-500 font-bold">${o.date}</span>
                        <h4 class="font-black text-xs text-emerald-400">${o.id}</h4>
                    </div>
                    <div class="text-xs text-slate-300 font-bold">العميل: ${o.phone}</div>
                    <div class="text-xs text-slate-400">الطلب: ${o.items.map(i => i.name).join(' | ')}</div>
                    <div class="flex justify-between items-center pt-1">
                        <div class="flex gap-1">
                            <button onclick="updateOrderStatus('${o.id}', 'مكتمل ✅')" class="bg-emerald-500/20 text-emerald-400 px-3 py-1 rounded-lg text-[10px] font-black border border-emerald-500/10 active:scale-95 transition">اعتماد وموافقة</button>
                            <button onclick="updateOrderStatus('${o.id}', 'مرفوض ❌')" class="bg-red-500/20 text-red-400 px-3 py-1 rounded-lg text-[10px] font-black border border-red-500/10 active:scale-95 transition">رفض وإلغاء</button>
                        </div>
                        <span class="text-xs font-black text-amber-400 bg-white/5 px-2 py-0.5 rounded-md border border-white/5">${o.status} | ${o.total} YER</span>
                    </div>
                </div>
            `).join('');
        }

        async function updateOrderStatus(id, status) {
            const masterKey = document.getElementById('master-key').value.trim();
            try {
                const res = await fetch(`${API}/api/admin/order/update-status`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ adminPass: masterKey, id, status })
                });
                if((await res.json()).success) { refreshDashboard(); showAdminToast("⚡ تم تحديث وإرسال إشعار الفاتورة للعميل"); }
            } catch(e){}
        }

        // رندر الحسابات وتعديل رصيد المحفظة الرقمية فوراً
        function renderUsers(users) {
            const container = document.getElementById('admin-users-list');
            container.innerHTML = users.map(u => `
                <div class="p-5 bg-white/5 border border-white/5 rounded-2xl text-right flex justify-between items-center gap-4">
                    <div class="flex gap-2 items-center">
                        <input type="number" id="bal-${u.phone}" value="${u.bal}" class="w-24 bg-black/60 border border-white/10 rounded-lg p-2 text-xs text-center font-black text-emerald-400 outline-none">
                        <button onclick="updateUserBalance('${u.phone}')" class="bg-emerald-500 text-black font-black px-3 py-2 rounded-lg text-[11px] active:scale-95 transition">تحديث</button>
                    </div>
                    <div>
                        <h4 class="font-black text-xs text-slate-200">${u.name}</h4>
                        <p class="text-[10px] text-slate-500 font-bold mt-0.5">${u.phone}</p>
                    </div>
                </div>
            `).join('');
        }

        async function updateUserBalance(phone) {
            const masterKey = document.getElementById('master-key').value.trim();
            const newBalance = document.getElementById(`bal-${phone}`).value;
            try {
                const res = await fetch(`${API}/api/admin/user/update-balance`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ adminPass: masterKey, phone, newBalance })
                });
                if((await res.json()).success) { refreshDashboard(); showAdminToast("💰 تم شحن محفظة العميل وإرسال رسالة تلقائية له"); }
            } catch(e){}
        }

        // رندر وعرض الرسائل الواردة من العملاء داخل لوحة التحكم
        function renderClientMessages(messages) {
            const container = document.getElementById('admin-client-messages');
            if(!messages || messages.length === 0) {
                container.innerHTML = '<div class="text-center py-6 text-xs text-slate-600 font-bold">لا توجد رسائل واردة حالياً من قاعدة البيانات</div>';
                return;
            }
            container.innerHTML = messages.map(m => `
                <div class="p-4 bg-amber-500/5 border border-amber-500/10 rounded-2xl text-right space-y-2">
                    <div class="flex justify-between items-center">
                        <span class="text-[10px] text-slate-500">${m.date}</span>
                        <button onclick="replyToClient('${m.sender}')" class="bg-amber-400 text-black px-2.5 py-0.5 rounded-md font-black text-[10px] active:scale-95 transition"><i class="fas fa-reply"></i> رد فوري</button>
                    </div>
                    <div class="text-xs font-black text-amber-400">من الهاتف: [ ${m.sender} ]</div>
                    <p class="text-xs text-slate-300 leading-relaxed bg-black/30 p-2.5 rounded-xl border border-white/5">${m.body}</p>
                </div>
            `).join('');
        }

        function replyToClient(phone) {
            switchTab('messages');
            document.getElementById('msg-to').value = phone;
            document.getElementById('msg-title').value = "رد من الإدارة ⚡";
            document.getElementById('msg-body').focus();
        }

        // إرسال رد أو رسالة من لوحة التحكم إلى العميل
        async function sendAdminMessage() {
            const masterKey = document.getElementById('master-key').value.trim();
            const receiver = document.getElementById('msg-to').value.trim();
            const title = document.getElementById('msg-title').value.trim();
            const body = document.getElementById('msg-body').value.trim();

            if(!receiver || !title || !body) return showAdminToast("⚠️ يرجى تعبئة كافة حقول الإشعار!");

            try {
                const res = await fetch(`${API}/api/messages/send`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ adminPass: masterKey, receiver, title, body })
                });
                if((await res.json()).success) {
                    document.getElementById('msg-title').value = "";
                    document.getElementById('msg-body').value = "";
                    playAdminSound('snd-success');
                    showAdminToast("✅ تم بث الإشعار بنجاح وحفظه في سجل الرسائل للعميل");
                }
            } catch(e){}
        }

        // إدارة الفئات والمنتجات والإنشاء مع الفلترة التلقائية
        async function addCategory() {
            const masterKey = document.getElementById('master-key').value.trim();
            const name = document.getElementById('cat-name').value.trim();
            const sub = document.getElementById('cat-sub').value.trim();
            const img = document.getElementById('cat-img').value.trim();

            try {
                const res = await fetch(`${API}/api/admin/category/add`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ adminPass: masterKey, name, sub, img })
                });
                if((await res.json()).success) {
                    document.getElementById('cat-name').value = ""; document.getElementById('cat-sub').value = ""; document.getElementById('cat-img').value = "";
                    playAdminSound('snd-success'); showAdminToast("🏢 تم إنشاء الفئة الجديدة وتثبيت الرابط الذكي!");
                    refreshDashboard();
                }
            } catch(e){}
        }

        async function addProduct() {
            const masterKey = document.getElementById('master-key').value.trim();
            const name = document.getElementById('prod-name').value.trim();
            const price = document.getElementById('prod-price').value.trim();
            const cat = document.getElementById('prod-cat').value.trim();
            const img = document.getElementById('prod-img').value.trim();

            try {
                const res = await fetch(`${API}/api/admin/product/add`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ adminPass: masterKey, name, price, cat, img })
                });
                if((await res.json()).success) {
                    document.getElementById('prod-name').value = ""; document.getElementById('prod-price').value = ""; document.getElementById('prod-img').value = "";
                    playAdminSound('snd-success'); showAdminToast("🛍️ تم نشر وتثبيت الخدمة الجديدة بالمتجر بنجاح!");
                    refreshDashboard();
                }
            } catch(e){}
        }

        async function updateAdVideo() {
            const masterKey = document.getElementById('master-key').value.trim();
            const videoUrl = document.getElementById('set-ad-url').value;
            await fetch(`${API}/api/admin/ad/add`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ adminPass: masterKey, videoUrl })
            });
            playAdminSound('snd-success');
            showAdminToast("🎬 تم تحديث وحفظ الفيديو الترويجي العلوي بنجاح!");
        }

        function switchTab(tabId) {
            document.querySelectorAll('.admin-panel').forEach(p => p.classList.add('hidden'));
            document.querySelectorAll('[id^="tab-"]').forEach(b => b.classList.replace('bg-emerald-500', 'bg-white/5'));
            document.querySelectorAll('[id^="tab-"]').forEach(b => b.classList.replace('text-black', 'text-slate-400'));

            document.getElementById(`panel-${tabId}`).classList.remove('hidden');
            document.getElementById(`tab-${tabId}`).classList.replace('bg-white/5', 'bg-emerald-500');
            document.getElementById(`tab-${tabId}`).classList.replace('text-slate-400', 'text-black');
        }

        function showAdminToast(m) {
            const t = document.getElementById('adm-toast');
            t.innerText = m; t.classList.remove('hidden');
            setTimeout(() => t.classList.add('hidden'), 5000);
        }
        function playAdminSound(id) { const s = document.getElementById(id); if(s) { s.currentTime = 0; s.play().catch(e=>{}); } }
    </script>
</body>
</html>

