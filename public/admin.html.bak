<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>إدارة تموينات أبو حسين | Ultra Control</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --bg-dark: #08090a;
            --bg-card: #0d0f11;
            --gold: #c5a862;
            --gold-hover: #b49550;
            --text-light: #ffffff;
            --text-muted: #8a8a8f;
            --border-color: #171a1f;
            --green-success: #2ecc71;
            --red-danger: #e74c3c;
            --orange-warn: #f39c12;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Cairo', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-light);
            direction: rtl;
            padding-bottom: 90px; /* مساحة للشريط السفلي الثابت */
        }

        header {
            background: #0d0f11;
            border-bottom: 2px solid var(--border-color);
            padding: 1rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        header h1 {
            color: var(--gold);
            font-size: 1.2rem;
            font-weight: 900;
        }

        .status-badge {
            background: rgba(197, 168, 98, 0.1);
            border: 1px solid var(--gold);
            color: var(--gold);
            padding: 0.3rem 0.8rem;
            border-radius: 2rem;
            font-size: 0.75rem;
            font-weight: bold;
        }

        .login-container {
            max-width: 400px;
            margin: 80px auto;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 1.5rem;
            padding: 2rem;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        .royal-input {
            width: 100%;
            padding: 0.85rem;
            background: #050607;
            border: 1px solid var(--border-color);
            border-radius: 0.75rem;
            color: #fff;
            font-size: 0.95rem;
            outline: none;
            transition: border-color 0.3s;
            text-align: center;
        }

        .royal-input:focus {
            border-color: var(--gold);
        }

        .royal-btn {
            background: var(--gold);
            color: #000;
            border: none;
            width: 100%;
            padding: 0.85rem;
            font-weight: 900;
            font-size: 1rem;
            border-radius: 0.75rem;
            cursor: pointer;
            transition: all 0.3s;
        }

        /* 📱 شريط الأزرار العشرة السفلي الثابت للتحكم الكامل */
        .admin-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: #0d0f11;
            border-top: 1px solid rgba(197, 168, 98, 0.2);
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 2px;
            padding: 5px;
            z-index: 1000;
            box-shadow: 0 -8px 25px rgba(0,0,0,0.8);
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            font-size: 0.65rem;
            font-weight: bold;
            padding: 8px 2px;
            cursor: pointer;
            transition: all 0.2s;
            border-radius: 0.5rem;
        }

        .nav-item i {
            font-size: 1.1rem;
            margin-bottom: 3px;
        }

        .nav-item.active {
            color: var(--gold);
            background: rgba(197, 168, 98, 0.08);
        }

        .admin-dashboard {
            display: none;
            padding: 1rem;
        }

        .card-container {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 1.25rem;
            padding: 1.25rem;
            margin-bottom: 1.5rem;
            overflow-x: auto;
        }

        .section-title {
            font-size: 1.1rem;
            font-weight: 900;
            color: var(--gold);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: right;
        }

        th {
            padding: 0.75rem;
            border-bottom: 2px solid var(--border-color);
            color: var(--text-muted);
            font-size: 0.8rem;
        }

        td {
            padding: 0.85rem 0.75rem;
            border-bottom: 1px solid var(--border-color);
            font-size: 0.85rem;
        }

        .image-uploader {
            border: 2px dashed var(--border-color);
            border-radius: 0.75rem;
            padding: 1.5rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            background: #050607;
            position: relative;
        }

        .image-uploader:hover {
            border-color: var(--gold);
        }

        .image-uploader i {
            font-size: 2rem;
            color: var(--text-muted);
            margin-bottom: 0.5rem;
        }

        .image-uploader img {
            max-height: 120px;
            border-radius: 0.5rem;
            margin-top: 0.5rem;
        }

        .action-btn {
            padding: 0.35rem 0.7rem;
            border-radius: 0.4rem;
            font-size: 0.75rem;
            font-weight: bold;
            cursor: pointer;
            border: none;
            transition: all 0.2s;
            margin: 2px;
        }

        .btn-success { background: rgba(46, 204, 113, 0.15); color: var(--green-success); }
        .btn-danger { background: rgba(231, 76, 60, 0.15); color: var(--red-danger); }
        .btn-info { background: rgba(197, 168, 98, 0.15); color: var(--gold); }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        .modal {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.85);
            z-index: 1100;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        .modal-content {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 1.5rem;
            width: 100%;
            max-width: 450px;
            padding: 1.5rem;
            max-height: 90vh;
            overflow-y: auto;
        }

        .loading-overlay {
            position: fixed;
            inset: 0;
            background: rgba(8, 9, 10, 0.95);
            z-index: 3000;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .spinner {
            width: 45px;
            height: 45px;
            border: 4px solid var(--border-color);
            border-top: 4px solid var(--gold);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin { 100% { transform: rotate(360deg); } }
    </style>
</head>
<body>

    <!-- واجهة التحميل الذكية -->
    <div id="loading" class="loading-overlay" style="display: none;">
        <div class="spinner"></div>
        <p id="loading-text" style="margin-top: 1rem; font-weight: bold; color: var(--gold); font-size: 0.9rem;">جاري معالجة ورفع البيانات...</p>
    </div>

    <!-- هيدر اللوحة -->
    <header>
        <h1>تموينات أبو حسين 👑</h1>
        <div class="status-badge" id="conn-status">غير متصل 🔒</div>
    </header>

    <!-- تسجيل الدخول -->
    <div class="login-container" id="login-screen">
        <h2 style="color:var(--gold); margin-bottom: 1rem; font-weight: 900;">بوابة التحكم الأمنية</h2>
        <input type="password" id="admin-pin" class="royal-input" placeholder="أدخل رمز الـ PIN هنا..." style="margin-bottom: 1.5rem;">
        <button class="royal-btn" onclick="tryLogin()">تحقق وتأكيد الهوية ⚡</button>
    </div>

    <!-- لوحة التحكم الرئيسية الشاملة لجميع التبويبات -->
    <div class="admin-dashboard" id="admin-dashboard">

        <!-- 1. تبويب العملاء -->
        <div id="tab-users" class="tab-content active">
            <div class="card-container">
                <div class="section-title"><i class="fa-solid fa-users"></i> إدارة رصيد العملاء</div>
                <input type="text" id="search-users" class="royal-input" oninput="filterUsers()" placeholder="ابحث باسم العميل أو رقمه..." style="margin-bottom: 1rem; text-align: right;">
                <table>
                    <thead>
                        <tr>
                            <th>العميل</th>
                            <th>الرصيد YER</th>
                            <th>تعديل</th>
                        </tr>
                    </thead>
                    <tbody id="users-table-body"></tbody>
                </table>
            </div>
        </div>

        <!-- 2. تبويب الطلبات -->
        <div id="tab-orders" class="tab-content">
            <div class="card-container">
                <div class="section-title"><i class="fa-solid fa-receipt"></i> الفواتير والطلبيات</div>
                <table>
                    <thead>
                        <tr>
                            <th>رقم الفاتورة</th>
                            <th>الهاتف</th>
                            <th>المجموع</th>
                            <th>خيارات المعالجة</th>
                        </tr>
                    </thead>
                    <tbody id="orders-table-body"></tbody>
                </table>
            </div>
        </div>

        <!-- 3. تبويب المنتجات السلعية (مع تعديل السعر السريع) -->
        <div id="tab-products" class="tab-content">
            <div class="card-container">
                <div class="section-title"><i class="fa-solid fa-box-open"></i> تعديل وحذف السلع</div>
                <table>
                    <thead>
                        <tr>
                            <th>صورة</th>
                            <th>الاسم السلعة</th>
                            <th>السعر</th>
                            <th>خيارات</th>
                        </tr>
                    </thead>
                    <tbody id="products-table-body"></tbody>
                </table>
            </div>
        </div>

        <!-- 4. تبويب إضافة منتج جديد (مع ميزة الرفع الذكي للصورة) -->
        <div id="tab-add-product" class="tab-content">
            <div class="card-container">
                <div class="section-title"><i class="fa-solid fa-plus-circle"></i> إضافة سلعة جديدة</div>
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    <div>
                        <label style="font-size: 0.8rem; color: var(--text-muted);">اسم المنتج</label>
                        <input type="text" id="new-prod-name" class="royal-input" placeholder="أرز بسمتي 5 كيلو" style="text-align: right;">
                    </div>
                    <div>
                        <label style="font-size: 0.8rem; color: var(--text-muted);">سعر البيع (YER)</label>
                        <input type="number" id="new-prod-price" class="royal-input" placeholder="12000" style="text-align: right;">
                    </div>
                    <div>
                        <label style="font-size: 0.8rem; color: var(--text-muted);">قسم السلعة</label>
                        <input type="text" id="new-prod-cat" class="royal-input" placeholder="مواد غذائية" style="text-align: right;">
                    </div>
                    <div>
                        <label style="font-size: 0.8rem; color: var(--text-muted);">صورة السلعة (تحميل من الألبوم)</label>
                        <div class="image-uploader" onclick="document.getElementById('file-product-img').click()">
                            <i class="fa-solid fa-image"></i>
                            <p style="font-size:0.75rem; color:var(--text-muted);">اضغط هنا لاختيار صورة من الاستوديو</p>
                            <img id="preview-prod-img" style="display: none;">
                            <input type="hidden" id="uploaded-prod-url">
                        </div>
                        <input type="file" id="file-product-img" style="display: none;" accept="image/*" onchange="uploadImageToCloud(this, 'preview-prod-img', 'uploaded-prod-url')">
                    </div>
                    <button class="royal-btn" onclick="saveNewProduct()">نشر السلعة بالمتجر فوراً 🚀</button>
                </div>
            </div>
        </div>

        <!-- 5. تبويب إضافة قسم جديد -->
        <div id="tab-add-category" class="tab-content">
            <div class="card-container">
                <div class="section-title"><i class="fa-solid fa-folder-plus"></i> إضافة قسم للمتجر</div>
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    <div>
                        <label style="font-size: 0.8rem; color: var(--text-muted);">اسم القسم الجديد</label>
                        <input type="text" id="new-cat-name" class="royal-input" placeholder="زيوت، ألبان، معلبات..." style="text-align: right;">
                    </div>
                    <div>
                        <label style="font-size: 0.8rem; color: var(--text-muted);">وصف فرعي (اختياري)</label>
                        <input type="text" id="new-cat-sub" class="royal-input" placeholder="أجود أنواع الزيوت والسمن" style="text-align: right;">
                    </div>
                    <div>
                        <label style="font-size: 0.8rem; color: var(--text-muted);">صورة القسم</label>
                        <div class="image-uploader" onclick="document.getElementById('file-category-img').click()">
                            <i class="fa-solid fa-folder-open"></i>
                            <p style="font-size:0.75rem; color:var(--text-muted);">اضغط هنا لاختيار صورة للقسم</p>
                            <img id="preview-cat-img" style="display: none;">
                            <input type="hidden" id="uploaded-cat-url">
                        </div>
                        <input type="file" id="file-category-img" style="display: none;" accept="image/*" onchange="uploadImageToCloud(this, 'preview-cat-img', 'uploaded-cat-url')">
                    </div>
                    <button class="royal-btn" onclick="saveNewCategory()">إنشاء القسم ونشره 📁</button>
                </div>
            </div>
        </div>

        <!-- 6. تبويب بث الرسائل والإشعارات -->
        <div id="tab-broadcast" class="tab-content">
            <div class="card-container">
                <div class="section-title"><i class="fa-solid fa-paper-plane"></i> إرسال إشعارات الهاتف</div>
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    <div>
                        <label style="font-size: 0.8rem; color: var(--text-muted);">المستلم (اكتب ALL للجميع أو رقم هاتف العميل)</label>
                        <input type="text" id="broadcast-receiver" class="royal-input" value="ALL" style="text-align: center;">
                    </div>
                    <div>
                        <label style="font-size: 0.8rem; color: var(--text-muted);">عنوان التنبيه</label>
                        <input type="text" id="broadcast-title" class="royal-input" placeholder="تحديث هام لخدماتنا..." style="text-align: right;">
                    </div>
                    <div>
                        <label style="font-size: 0.8rem; color: var(--text-muted);">نص الإشعار</label>
                        <textarea id="broadcast-body" class="royal-input" placeholder="اكتب تفاصيل الإشعار هنا..." style="height: 100px; resize: none; text-align: right;"></textarea>
                    </div>
                    <button class="royal-btn" onclick="sendBroadcast()">إرسال الإشعار لجميع الأجهزة 🔔</button>
                </div>
            </div>
        </div>

        <!-- 7. تبويب الإعلانات ومقاطع الفيديو اليوتيوب -->
        <div id="tab-ads" class="tab-content">
            <div class="card-container">
                <div class="section-title"><i class="fa-solid fa-video"></i> الإعلانات والفيديو الترويجي</div>
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    <div>
                        <label style="font-size: 0.8rem; color: var(--text-muted);">رابط فيديو يوتيوب (العرض الترويجي بالتطبيق)</label>
                        <input type="text" id="new-ad-url" class="royal-input" placeholder="https://www.youtube.com/watch?v=..." style="direction: ltr;">
                    </div>
                    <button class="royal-btn" onclick="savePromoVideo()">تحديث الفيديو الإعلاني 🎬</button>
                </div>
            </div>
        </div>

        <!-- 8. تبويب الإعدادات العامة للمنظومة -->
        <div id="tab-settings" class="tab-content">
            <div class="card-container">
                <div class="section-title"><i class="fa-solid fa-gears"></i> إعدداات التطبيق</div>
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    <div>
                        <label style="font-size: 0.8rem; color: var(--text-muted);">اسم التطبيق</label>
                        <input type="text" id="set-app-name" class="royal-input" style="text-align: right;">
                    </div>
                    <div>
                        <label style="font-size: 0.8rem; color: var(--text-muted);">رقم الدعم الفني (واتساب)</label>
                        <input type="text" id="set-app-wa" class="royal-input" style="text-align: center;">
                    </div>
                    <div>
                        <label style="font-size: 0.8rem; color: var(--text-muted);">إصدار التطبيق الحارس</label>
                        <input type="text" id="set-app-ver" class="royal-input" style="text-align: center;">
                    </div>
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <span>وضع الصيانة والتحصين ⚙️</span>
                        <input type="checkbox" id="set-app-maint" style="width: 25px; height: 25px;">
                    </div>
                    <button class="royal-btn" onclick="saveAppSettings()">تثبيت التغييرات 💾</button>
                </div>
            </div>
        </div>

        <!-- 9. تبويب حركة سجل العمليات المنجزة وميجا سنتر -->
        <div id="tab-transactions" class="tab-content">
            <div class="card-container">
                <div class="section-title"><i class="fa-solid fa-bolt"></i> عمليات شحن الألعاب الفورية</div>
                <table>
                    <thead>
                        <tr>
                            <th>العميل</th>
                            <th>الخدمة</th>
                            <th>المبلغ YER</th>
                            <th>الحالة</th>
                        </tr>
                    </thead>
                    <tbody id="tx-table-body"></tbody>
                </table>
            </div>
        </div>

        <!-- 10. تبويب الأقسام الحالية (تعديل وحذف الأقسام) -->
        <div id="tab-categories-list" class="tab-content">
            <div class="card-container">
                <div class="section-title"><i class="fa-solid fa-list"></i> إدارة وتعديل أقسام المتجر</div>
                <table>
                    <thead>
                        <tr>
                            <th>صورة</th>
                            <th>اسم القسم</th>
                            <th>خيارات</th>
                        </tr>
                    </thead>
                    <tbody id="categories-table-body"></tbody>
                </table>
            </div>
        </div>

    </div>

    <!-- 📱 شريط الأزرار العشرة السفلي الثابت باللمس المباشر للموبايل -->
    <div class="admin-nav" id="admin-nav" style="display: none;">
        <!-- الصف الأول -->
        <div class="nav-item active" onclick="switchNavTab(this, 'tab-users')"><i class="fa-solid fa-users"></i>رصيد</div>
        <div class="nav-item" onclick="switchNavTab(this, 'tab-orders')"><i class="fa-solid fa-file-invoice"></i>طلبيات</div>
        <div class="nav-item" onclick="switchNavTab(this, 'tab-products')"><i class="fa-solid fa-edit"></i>تعديل سلعة</div>
        <div class="nav-item" onclick="switchNavTab(this, 'tab-add-product')"><i class="fa-solid fa-cart-plus"></i>سلعة➕</div>
        <div class="nav-item" onclick="switchNavTab(this, 'tab-add-category')"><i class="fa-solid fa-folder-plus"></i>قسم➕</div>
        
        <!-- الصف الثاني -->
        <div class="nav-item" onclick="switchNavTab(this, 'tab-categories-list')"><i class="fa-solid fa-list-ul"></i>أقسام</div>
        <div class="nav-item" onclick="switchNavTab(this, 'tab-broadcast')"><i class="fa-solid fa-bell"></i>بث إشعار</div>
        <div class="nav-item" onclick="switchNavTab(this, 'tab-ads')"><i class="fa-solid fa-play"></i>فيديو🎬</div>
        <div class="nav-item" onclick="switchNavTab(this, 'tab-transactions')"><i class="fa-solid fa-shuffle"></i>سجل الألعاب</div>
        <div class="nav-item" onclick="switchNavTab(this, 'tab-settings')"><i class="fa-solid fa-cog"></i>إعدادات</div>
    </div>

    <!-- نافذة تعديل الرصيد للعميل -->
    <div id="balance-modal" class="modal">
        <div class="modal-content">
            <h3 style="color:var(--gold); margin-bottom:1rem;"><i class="fa-solid fa-wallet"></i> تعديل رصيد حساب العميل</h3>
            <p id="bal-modal-title" style="font-size:0.85rem; color:var(--text-muted); margin-bottom:1rem;"></p>
            <input type="number" id="bal-modal-input" class="royal-input" style="margin-bottom:1.5rem;">
            <div style="display:flex; gap:10px;">
                <button class="royal-btn" id="bal-modal-save">حفظ وتحديث 💰</button>
                <button class="royal-btn" style="background:#222; color:#fff;" onclick="closeModal('balance-modal')">إلغاء</button>
            </div>
        </div>
    </div>

    <!-- نافذة تعديل سعر سلعة سريعاً -->
    <div id="price-modal" class="modal">
        <div class="modal-content">
            <h3 style="color:var(--gold); margin-bottom:1rem;"><i class="fa-solid fa-tag"></i> تعديل سعر السلعة</h3>
            <p id="price-modal-title" style="font-size:0.85rem; color:var(--text-muted); margin-bottom:1rem;"></p>
            <input type="number" id="price-modal-input" class="royal-input" style="margin-bottom:1.5rem;">
            <div style="display:flex; gap:10px;">
                <button class="royal-btn" id="price-modal-save">تحديث السعر الحالي ⚡</button>
                <button class="royal-btn" style="background:#222; color:#fff;" onclick="closeModal('price-modal')">إلغاء</button>
            </div>
        </div>
    </div>

    <script>
        const API_URL = window.location.origin;
        let ADMIN_PIN = "";
        let dataStore = { users: [], orders: [], products: [], categories: [], transactions: [] };

        function showLoader(status, msg = "جاري الاتصال بالسيرفر سحابياً...") {
            document.getElementById('loading-text').innerText = msg;
            document.getElementById('loading').style.display = status ? 'flex' : 'none';
        }

        async function tryLogin() {
            const pin = document.getElementById('admin-pin').value;
            if(!pin) return alert("يرجى إدخال رمز الحماية!");

            showLoader(true, "جاري مطابقة الرمز الفولاذي...");
            try {
                const res = await fetch(`${API_URL}/api/admin/users?adminPass=${pin}`);
                if(res.ok) {
                    ADMIN_PIN = pin;
                    document.getElementById('login-screen').style.display = 'none';
                    document.getElementById('admin-dashboard').style.display = 'block';
                    document.getElementById('admin-nav').style.display = 'grid';
                    
                    document.getElementById('conn-status').innerText = "متصل سحابياً بالرئيسي ☁️";
                    document.getElementById('conn-status').style.borderColor = "var(--green-success)";
                    document.getElementById('conn-status').style.color = "var(--green-success)";

                    await refreshAllData();
                } else {
                    alert("الرمز السري خاطئ أو السيرفر يرفض الإذن!");
                }
            } catch (e) {
                alert("فشل في الاتصال بسيرفر راندر.");
            } finally {
                showLoader(false);
            }
        }

        async function refreshAllData() {
            showLoader(true, "مزامنة البيانات الحية بقاعدة البيانات...");
            try {
                const resUsers = await fetch(`${API_URL}/api/admin/users?adminPass=${ADMIN_PIN}`);
                if(resUsers.ok) dataStore.users = await resUsers.json();

                const resProds = await fetch(`${API_URL}/api/admin/products?adminPass=${ADMIN_PIN}`);
                if(resProds.ok) dataStore.products = await resProds.json();

                const resOrders = await fetch(`${API_URL}/api/admin/orders?adminPass=${ADMIN_PIN}`);
                if(resOrders.ok) dataStore.orders = await resOrders.json();

                const resCats = await fetch(`${API_URL}/api/admin/categories?adminPass=${ADMIN_PIN}`);
                if(resCats.ok) dataStore.categories = await resCats.json();

                const resTx = await fetch(`${API_URL}/api/admin/transactions?adminPass=${ADMIN_PIN}`);
                if(resTx.ok) dataStore.transactions = await resTx.json();

                renderUsers(dataStore.users);
                renderOrders();
                renderProducts();
                renderCategories();
                renderTransactions();
                loadAppSettings();

            } catch (err) {
                console.error("خطأ في تحديث البيانات:", err);
            } finally {
                showLoader(false);
            }
        }

        function switchNavTab(btn, tabId) {
            document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));

            btn.classList.add('active');
            document.getElementById(tabId).classList.add('active');
        }

        // 🖼️ دالة معالجة ورفع الصورة التلقائية باستخدام مفتاح ImgBB الجديد الخاص بك
        async function uploadImageToCloud(inputElement, previewImgId, hiddenInputId) {
            const file = inputElement.files[0];
            if(!file) return;

            showLoader(true, "جاري تحويل ومعالجة الصورة واستخراج رابط مباشر...");
            
            const formData = new FormData();
            formData.append('image', file);

            try {
                // دمج مفتاحك السري هنا مباشرة ليعمل الرفع بنجاح وحرية تامة
                const response = await fetch('https://api.imgbb.com/1/upload?key=e56f7dca95ebd01e877966299ebb03c3', {
                    method: 'POST',
                    body: formData
                });
                const resData = await response.json();

                if(resData.success) {
                    const directUrl = resData.data.url;
                    document.getElementById(hiddenInputId).value = directUrl;
                    
                    const imgPreview = document.getElementById(previewImgId);
                    imgPreview.src = directUrl;
                    imgPreview.style.display = 'block';
                    
                    alert("تم تحويل الصورة بنجاح ودمجها مع السيرفر السحابي! 📸⚡");
                } else {
                    alert("فشل معالجة الصورة، قد يكون الحجم كبيراً جداً.");
                }
            } catch (err) {
                alert("خطأ أثناء الاتصال بخادم الصور السحابي.");
            } finally {
                showLoader(false);
            }
        }

        function renderUsers(list) {
            const tbody = document.getElementById('users-table-body');
            tbody.innerHTML = "";
            list.forEach(u => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td style="font-weight:bold;">${u.name}</td>
                    <td style="color:var(--gold); font-weight:bold;">${Number(u.balance).toLocaleString()} YER</td>
                    <td>
                        <button class="action-btn btn-info" onclick="openBalanceModal('${u.phone}', '${u.name}', ${u.balance})"><i class="fa-solid fa-edit"></i> شحن</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function filterUsers() {
            const q = document.getElementById('search-users').value.toLowerCase();
            const filtered = dataStore.users.filter(u => u.name.toLowerCase().includes(q) || u.phone.includes(q));
            renderUsers(filtered);
        }

        function openBalanceModal(phone, name, balance) {
            document.getElementById('bal-modal-title').innerText = `المستخدم: ${name} (${phone})`;
            document.getElementById('bal-modal-input').value = balance;
            document.getElementById('balance-modal').style.display = 'flex';

            document.getElementById('bal-modal-save').onclick = async () => {
                const val = document.getElementById('bal-modal-input').value;
                showLoader(true, "جاري تحديث حساب العميل وبث الإشعار...");
                try {
                    const res = await fetch(`${API_URL}/api/admin/user/update-balance`, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ adminPass: ADMIN_PIN, phone, newBalance: Number(val) })
                    });
                    if(res.ok) {
                        alert("تم تعديل الرصيد وتنبيه هاتف العميل فوراً! 🎉");
                        closeModal('balance-modal');
                        await refreshAllData();
                    }
                } catch(e) { alert("خطأ في الاتصال"); }
                finally { showLoader(false); }
            };
        }

        function renderProducts() {
            const tbody = document.getElementById('products-table-body');
            tbody.innerHTML = "";
            dataStore.products.forEach(p => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><img src="${p.img || 'https://via.placeholder.com/40'}" style="width:35px; height:35px; object-fit:cover; border-radius:5px;"></td>
                    <td>${p.name}</td>
                    <td style="color:var(--gold); font-weight:bold;">${Number(p.price).toLocaleString()} YER</td>
                    <td>
                        <button class="action-btn btn-info" onclick="openPriceModal('${p._id}', '${p.name}', ${p.price})"><i class="fa-solid fa-tag"></i> سعر</button>
                        <button class="action-btn btn-danger" onclick="deleteProduct('${p._id}')"><i class="fa-solid fa-trash"></i></button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function openPriceModal(id, name, currentPrice) {
            document.getElementById('price-modal-title').innerText = `السلعة: ${name}`;
            document.getElementById('price-modal-input').value = currentPrice;
            document.getElementById('price-modal').style.display = 'flex';

            document.getElementById('price-modal-save').onclick = async () => {
                const newPrice = document.getElementById('price-modal-input').value;
                if(!newPrice) return alert("يرجى وضع السعر!");
                
                showLoader(true, "جاري تعديل السعر...");
                try {
                    const targetProduct = dataStore.products.find(x => x._id === id);
                    if(targetProduct) {
                        await fetch(`${API_URL}/api/admin/products/delete`, {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ adminPass: ADMIN_PIN, id: id })
                        });
                        await fetch(`${API_URL}/api/admin/products/add`, {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                adminPass: ADMIN_PIN,
                                name: targetProduct.name,
                                price: Number(newPrice),
                                image: targetProduct.img,
                                cat: targetProduct.cat
                            })
                        });
                        alert("تم تعديل سعر السلعة بنجاح! ⚡");
                        closeModal('price-modal');
                        await refreshAllData();
                    }
                } catch(e) { alert("فشل في العملية السريعة لتحديث السعر."); }
                finally { showLoader(false); }
            };
        }

        async function deleteProduct(id) {
            if(!confirm("حذف هذه السلعة بشكل نهائي؟")) return;
            showLoader(true);
            try {
                await fetch(`${API_URL}/api/admin/products/delete`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ adminPass: ADMIN_PIN, id })
                });
                await refreshAllData();
            } catch(e){} finally { showLoader(false); }
        }

        async function saveNewProduct() {
            const name = document.getElementById('new-prod-name').value;
            const price = document.getElementById('new-prod-price').value;
            const cat = document.getElementById('new-prod-cat').value;
            const imgUrl = document.getElementById('uploaded-prod-url').value;

            if(!name || !price || !cat) return alert("املأ البيانات كاملة!");

            showLoader(true, "جاري نشر السلعة بالمتجر...");
            try {
                const res = await fetch(`${API_URL}/api/admin/products/add`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        adminPass: ADMIN_PIN,
                        name,
                        price: Number(price),
                        image: imgUrl || "https://megatec-center.com/img/raw/11_img.jpeg",
                        cat
                    })
                });
                if(res.ok) {
                    alert("تم حفظ ونشر السلعة الجديدة بنجاح! 🎉");
                    document.getElementById('new-prod-name').value = "";
                    document.getElementById('new-prod-price').value = "";
                    document.getElementById('new-prod-cat').value = "";
                    document.getElementById('uploaded-prod-url').value = "";
                    document.getElementById('preview-prod-img').style.display = 'none';
                    await refreshAllData();
                }
            } catch(e) {} finally { showLoader(false); }
        }

        async function saveNewCategory() {
            const name = document.getElementById('new-cat-name').value;
            const sub = document.getElementById('new-cat-sub').value;
            const imgUrl = document.getElementById('uploaded-cat-url').value;

            if(!name) return alert("يرجى إدخال اسم القسم!");

            showLoader(true, "جاري إضافة وتجهيز القسم...");
            try {
                const res = await fetch(`${API_URL}/api/admin/category/add`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        adminPass: ADMIN_PIN,
                        name,
                        sub,
                        img: imgUrl || "https://megatec-center.com/img/raw/11_img.jpeg"
                    })
                });
                if(res.ok) {
                    alert("تم إنشاء القسم الجديد وعرضه في واجهة العملاء بنجاح! 📁");
                    document.getElementById('new-cat-name').value = "";
                    document.getElementById('new-cat-sub').value = "";
                    document.getElementById('uploaded-cat-url').value = "";
                    document.getElementById('preview-cat-img').style.display = 'none';
                    await refreshAllData();
                }
            } catch(e) {} finally { showLoader(false); }
        }

        function renderCategories() {
            const tbody = document.getElementById('categories-table-body');
            tbody.innerHTML = "";
            dataStore.categories.forEach(c => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><img src="${c.img || 'https://via.placeholder.com/40'}" style="width:35px; height:35px; object-fit:cover; border-radius:5px;"></td>
                    <td>${c.name}</td>
                    <td>
                        <button class="action-btn btn-danger" onclick="deleteCategory('${c._id}')"><i class="fa-solid fa-trash"></i> حذف</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        async function deleteCategory(id) {
            if(!confirm("حذف هذا القسم بالكامل؟")) return;
            showLoader(true);
            try {
                await fetch(`${API_URL}/api/admin/category/delete`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ adminPass: ADMIN_PIN, id })
                });
                await refreshAllData();
            } catch(e){} finally { showLoader(false); }
        }

        function renderOrders() {
            const tbody = document.getElementById('orders-table-body');
            tbody.innerHTML = "";
            dataStore.orders.forEach(o => {
                const itemsStr = o.items.map(i => `${i.name} (${i.qty})`).join(' - ');
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${o.id || 'INV'}</td>
                    <td>${o.phone}</td>
                    <td style="color:var(--gold); font-weight:bold;">${Number(o.total).toLocaleString()} YER</td>
                    <td>
                        <button class="action-btn btn-success" onclick="updateOrderStatus('${o.id}', 'مقبول وتم التجهيز ✅')">قبول</button>
                        <button class="action-btn btn-danger" onclick="updateOrderStatus('${o.id}', 'مرفوض ❌')">رفض</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        async function updateOrderStatus(id, status) {
            showLoader(true);
            try {
                await fetch(`${API_URL}/api/admin/orders/update-status`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ adminPass: ADMIN_PIN, id, status })
                });
                await refreshAllData();
            } catch(e){} finally { showLoader(false); }
        }

        function renderTransactions() {
            const tbody = document.getElementById('tx-table-body');
            tbody.innerHTML = "";
            dataStore.transactions.forEach(tx => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${tx.phone}</td>
                    <td>${tx.serviceName}</td>
                    <td>${tx.price} YER</td>
                    <td>${tx.status}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        async function sendBroadcast() {
            const receiver = document.getElementById('broadcast-receiver').value;
            const title = document.getElementById('broadcast-title').value;
            const body = document.getElementById('broadcast-body').value;

            if(!receiver || !title || !body) return alert("املأ حقول البث!");
            showLoader(true, "بث التنبيه لجميع الهواتف المشتركة...");
            try {
                const res = await fetch(`${API_URL}/api/messages/send`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ adminPass: ADMIN_PIN, receiver, title, body })
                });
                if(res.ok) {
                    alert("تم إرسال الإشعار ودفعه للأجهزة بنجاح! 🔔");
                    document.getElementById('broadcast-title').value = "";
                    document.getElementById('broadcast-body').value = "";
                }
            } catch(e){} finally { showLoader(false); }
        }

        async function savePromoVideo() {
            const url = document.getElementById('new-ad-url').value;
            if(!url) return alert("أدخل رابط يوتيوب!");
            showLoader(true, "جاري ربط الفيديو الترويجي بالتطبيق...");
            try {
                const res = await fetch(`${API_URL}/api/admin/ad/add`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ adminPass: ADMIN_PIN, videoUrl: url })
                });
                if(res.ok) {
                    alert("تم تحديث الفيديو الإعلاني بنجاح! 🎬");
                }
            } catch(e){} finally { showLoader(false); }
        }

        async function loadAppSettings() {
            try {
                const res = await fetch(`${API_URL}/api/admin/settings?adminPass=${ADMIN_PIN}`);
                if(res.ok) {
                    const data = await res.json();
                    document.getElementById('set-app-name').value = data.appName || "";
                    document.getElementById('set-app-wa').value = data.whatsappSupport || "";
                    document.getElementById('set-app-ver').value = data.appVersion || "";
                    document.getElementById('set-app-maint').checked = data.maintenanceMode || false;
                }
            } catch(e){}
        }

        async function saveAppSettings() {
            showLoader(true, "حفظ الإعدادات وتأمين المنظومة...");
            try {
                const res = await fetch(`${API_URL}/api/admin/settings/update`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        adminPass: ADMIN_PIN,
                        appName: document.getElementById('set-app-name').value,
                        whatsappSupport: document.getElementById('set-app-wa').value,
                        appVersion: document.getElementById('set-app-ver').value,
                        maintenanceMode: document.getElementById('set-app-maint').checked
                    })
                });
                if(res.ok) alert("تم حفظ الإعدادات بالكامل! 💾");
            } catch(e){} finally { showLoader(false); }
        }

        function closeModal(id) { document.getElementById(id).style.display = 'none'; }
    </script>
</body>
</html>

