<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>تموينات أبو حسين | النظام المتكامل</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body class="min-h-screen pb-32">

    <audio id="snd-click" src="https://assets.mixkit.co/active_storage/sfx/2568/2358-preview.mp3" preload="auto"></audio>
    <audio id="snd-cashier" src="https://assets.mixkit.co/active_storage/sfx/592/592-preview.mp3" preload="auto"></audio>
    <audio id="snd-notification" src="https://assets.mixkit.co/active_storage/sfx/911/911-preview.mp3" preload="auto"></audio>

    <div id="splash" class="fixed inset-0 z-[3000] bg-[#08090a] flex items-center justify-center">
        <div class="text-center space-y-2">
            <h1 class="text-4xl font-black text-[#ffcc00]">أبو حسين</h1>
            <p class="text-[9px] text-gray-600 font-bold tracking-widest">SYSTEM READY</p>
        </div>
    </div>

    <div id="auth-screen" class="fixed inset-0 z-[2000] hidden flex items-center justify-center p-6 bg-black/90">
        <div class="w-full max-w-md bg-[#0d0f11] p-8 rounded-[2rem] border border-[#1d2127]">
            <h2 id="auth-title" class="text-2xl font-black text-[#ffcc00] text-center mb-6">تسجيل الدخول</h2>
            <div id="signup-name-container" class="hidden mb-4"><input type="text" id="auth-name" class="royal-input" placeholder="الاسم الكامل"></div>
            <input type="tel" id="auth-phone" class="royal-input mb-4" placeholder="رقم الهاتف">
            <input type="password" id="auth-pass" class="royal-input mb-6" placeholder="الرمز السري">
            <button onclick="handleAuth()" class="w-full bg-[#ffcc00] text-black font-black py-4 rounded-xl">دخول</button>
            <button onclick="toggleAuthMode()" class="w-full text-xs text-gray-500 mt-4 underline">تبديل بين الدخول وإنشاء حساب</button>
        </div>
    </div>

    <div id="app-layout" class="hidden pt-28 px-6 space-y-8">
        <header class="fixed top-0 left-0 right-0 z-[1000] px-6 py-4 cyber-header flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div id="u-avatar" class="w-10 h-10 bg-[#ffcc00] text-black rounded-xl flex items-center justify-center font-black">م</div>
                <div><h1 class="font-black text-sm text-white">تموينات أبو حسين</h1></div>
            </div>
            <div id="u-balance-top" class="px-4 py-2 bg-[#121418] border border-[#1d2127] rounded-full text-[#ffcc00] font-black text-xs">0 YER</div>
        </header>

        <div id="view-home" class="view-content"><div id="categories-list" class="cards-container mode-dual"></div></div>
        <div id="view-products" class="view-content hidden"><div id="products-list"></div></div>
        <div id="view-games" class="view-content hidden"><div id="games-list"></div></div>
        <div id="view-orders" class="view-content hidden"><div id="orders-list"></div></div>
        <div id="view-notifications" class="view-content hidden"><div id="messages-list"></div></div>
        <div id="view-account" class="view-content hidden">
            <div class="p-6 bg-[#121418] rounded-2xl border border-[#1d2127] text-center">
                <h3 id="acc-name" class="font-black text-white">--</h3>
                <button onclick="logout()" class="mt-6 w-full bg-red-900/20 text-red-500 py-3 rounded-xl font-black">تسجيل الخروج</button>
            </div>
        </div>

        <nav class="fixed bottom-0 left-0 right-0 h-20 cyber-nav z-[500] px-1 flex justify-around items-center">
            <button onclick="changeView('home', this)" class="nav-item active"><i class="fas fa-home"></i><span>الرئيسية</span></button>
            <button onclick="changeView('games', this)" class="nav-item"><i class="fas fa-gamepad"></i><span>الألعاب</span></button>
            <button onclick="changeView('cart', this)" class="nav-item"><i class="fas fa-shopping-bag"></i><span>السلة</span></button>
            <button onclick="changeView('orders', this)" class="nav-item"><i class="fas fa-receipt"></i><span>فواتيري</span></button>
            <button onclick="changeView('notifications', this)" class="nav-item"><i class="fas fa-bell"></i><span>الرسائل</span></button>
            <button onclick="changeView('account', this)" class="nav-item"><i class="fas fa-user-circle"></i><span>حسابي</span></button>
        </nav>
    </div>

    <div id="toast" class="fixed bottom-28 left-6 right-6 z-[4000] bg-[#ffcc00] text-black px-5 py-4 rounded-xl text-xs font-black text-center hidden"></div>

    <script src="script.js"></script>
</body>
</html>
