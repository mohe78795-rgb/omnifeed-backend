<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>أبو حسين Supplies | Prestige</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body class="bg-[#05070a] text-white">

    <audio id=\"snd-click\" src="https://assets.mixkit.co/active_storage/sfx/2568/2358-preview.mp3" preload="auto"></audio>
    <audio id=\"snd-cashier\" src="https://assets.mixkit.co/active_storage/sfx/592/592-preview.mp3" preload="auto"></audio>

    <div class="blob"></div>
    <div class="blob blob-2"></div>

    <div id="splash" class="fixed inset-0 z-[3000] bg-[#05070a] flex items-center justify-center">
        <h1 class="text-3xl font-black text-emerald-500 tracking-wider animate-pulse">أبو حسين SUPPLIES</h1>
    </div>

    <div id="auth-screen" class="fixed inset-0 z-[2000] auth-bg hidden overflow-y-auto px-6 py-12 flex flex-col justify-center">
        <div class="max-w-md w-full mx-auto space-y-8 bg-black/40 backdrop-blur-xl p-8 rounded-[2.5rem] border border-white/5">
            <div class="text-center">
                <h2 id="auth-title" class="text-3xl font-black text-emerald-400">تسجيل الدخول</h2>
                <p id="auth-desc" class="text-xs text-slate-400 mt-2">أهلاً بك في منصة أبو حسين لخدمات الشحن</p>
            </div>
            
            <div class="space-y-4">
                <div id="signup-name-container" class="hidden">
                    <input type="text" id="auth-name" class="royal-input" placeholder="الاسم الكامل">
                </div>
                <input type="tel" id="auth-phone" class="royal-input" placeholder="رقم الهاتف (7xxxxxxxx)">
                <input type="password" id="auth-pass" class="royal-input" placeholder="كلمة المرور">
            </div>

            <button onclick="handleAuth()" id="auth-btn" class="w-full bg-emerald-500 text-black font-black py-4 rounded-2xl shadow-lg shadow-emerald-500/20 active:scale-95 transition">دخول آمن</button>
            
            <p class="text-center text-xs text-slate-400">
                <span id="auth-toggle-text">ليس لديك حساب؟</span>
                <button onclick="toggleAuthMode()" id="auth-toggle-btn" class="text-emerald-400 font-bold underline ml-1">إنشاء حساب جديد</button>
            </p>
        </div>
    </div>

    <div id="app-layout" class="hidden pb-32">
        <header class="fixed top-0 left-0 right-0 z-[1000] px-6 py-6 bg-black/60 backdrop-blur-xl border-b border-white/5 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div id="u-avatar" class="w-10 h-10 bg-emerald-500 text-black rounded-xl flex items-center justify-center font-black">..</div>
                <div>
                    <h1 class="font-black text-sm" id="acc-name-display">أبو حسين</h1>
                    <span class="text-[8px] text-emerald-500 animate-pulse">متصل الآن</span>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button id="refresh-btn" onclick="manualRefresh()" class="w-10 h-10 bg-white/5 rounded-xl border border-white/5 flex items-center justify-center active:scale-95 transition-all duration-300">
                    <i class="fas fa-sync-alt text-emerald-500 text-xs"></i>
                </button>
                <div id="u-balance-top" class="px-4 py-2 bg-emerald-500/10 border border-emerald-500/20 rounded-full text-emerald-500 font-black text-[11px]">0 YER</div>
            </div>
        </header>

        <main class="pt-28 px-6 max-w-xl mx-auto space-y-8">
            
            <div id="view-home" class="view-content space-y-8 animate-fadeIn">
                <div id="ad-video-container" class="w-full aspect-video bg-slate-900/40 rounded-[2rem] border border-white/5 overflow-hidden hidden shadow-2xl">
                    <iframe id="ad-video-player" class="w-full h-full" src="" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
                </div>

                <div class="flex justify-between items-center">
                    <div>
                        <h2 class="text-2xl font-black">أقسام الخدمات</h2>
                        <p class="text-[10px] text-slate-400 mt-1">اختر الفئة المفضلة لبدء طلبك الفوري</p>
                    </div>
                    <div class="flex gap-2 bg-white/5 p-1 rounded-xl border border-white/5">
                        <button onclick="setLayout(0)" id="btn-layout-0" class="w-8 h-8 rounded-lg flex items-center justify-center text-xs bg-emerald-500 text-black"><i class="fas fa-th-large"></i></button>
                        <button onclick="setLayout(1)" id="btn-layout-1" class="w-8 h-8 rounded-lg flex items-center justify-center text-xs text-slate-400"><i class="fas fa-th"></i></button>
                        <button onclick="setLayout(2)" id="btn-layout-2" class="w-8 h-8 rounded-lg flex items-center justify-center text-xs text-slate-400"><i class="fas fa-bars"></i></button>
                    </div>
                </div>

                <div id="categories-list" class="cards-container mode-dual"></div>
            </div>

            <div id="view-games" class="view-content hidden space-y-6 animate-fadeIn">
                <div>
                    <h2 class="text-2xl font-black">شحن الألعاب الفوري ⚡</h2>
                    <p class="text-[10px] text-slate-400 mt-1">شحن تلقائي ومباشر إلى حسابك خلال ثوانٍ</p>
                </div>
                <div id="games-list" class="grid grid-cols-1 gap-4"></div>

                <div id="game-topup-panel" class="hidden bg-slate-900/30 p-6 rounded-[2rem] border border-white/5 space-y-4 animate-slideUp">
                    <h3 id="selected-game-title" class="font-black text-emerald-400 text-lg"></h3>
                    <div class="space-y-2">
                        <label class="text-xs text-slate-400">أدخل معرف اللاعب (ID):</label>
                        <div class="flex gap-2">
                            <input type="text" id="game-player-id" class="royal-input" placeholder="ID الحساب">
                            <button onclick="validatePlayer()" class="bg-emerald-500 text-black font-bold px-4 rounded-xl text-xs active:scale-95 transition">التحقق</button>
                        </div>
                        <p id="player-name-display" class="text-xs text-emerald-400 font-bold hidden"></p>
                    </div>
                    <div class="space-y-2">
                        <label class="text-xs text-slate-400">اختر الفئة المطلوبة:</label>
                        <div id="game-denoms-list" class="grid grid-cols-2 gap-2"></div>
                    </div>
                    <button onclick="processGameTopup()" class="w-full bg-emerald-500 text-black font-black py-4 rounded-xl text-sm mt-4 shadow-lg active:scale-95 transition">تأكيد الشحن الفوري الفوري</button>
                </div>
            </div>

            <div id="view-products" class="view-content hidden space-y-6 animate-fadeIn">
                <button onclick="changeView('home', null)" class="text-xs text-emerald-400 font-bold flex items-center gap-2"><i class="fas fa-arrow-right"></i> العودة للأقسام</button>
                <h2 id="cat-title-display" class="text-2xl font-black">المنتجات</h2>
                <div id="products-list" class="grid grid-cols-1 gap-4"></div>
            </div>

            <div id="view-notifications" class="view-content hidden space-y-6 animate-fadeIn">
                <div>
                    <h2 class="text-2xl font-black">الرسائل والإشعارات</h2>
                    <p class="text-[10px] text-slate-400 mt-1">تنبيهات الإدارة، العروض، وحركات حسابك</p>
                </div>
                <div id="messages-list" class="space-y-4"></div>
            </div>

            <div id="view-orders" class="view-content hidden space-y-6 animate-fadeIn">
                <h2 class="text-2xl font-black">سجل الفواتير والعمليات</h2>
                <div id="orders-list" class="space-y-4"></div>
            </div>

            <div id="view-cart" class="view-content hidden space-y-6 animate-fadeIn">
                <h2 class="text-2xl font-black">سلة المشتريات</h2>
                <div id="cart-list" class="space-y-4"></div>
                <div class="p-6 bg-white/5 rounded-[2rem] border border-white/5 flex justify-between items-center">
                    <span class="text-sm font-bold text-slate-400">الإجمالي المستحق:</span>
                    <span id="cart-total" class="text-xl font-black text-emerald-400">0 YER</span>
                </div>
                <button onclick="checkout()" class="w-full bg-emerald-500 text-black font-black py-4 rounded-2xl text-sm shadow-xl active:scale-95 transition">إرسال الطلب ودفع الرصيد</button>
            </div>

            <div id="view-account" class="view-content hidden space-y-6 animate-fadeIn">
                <h2 class="text-2xl font-black">إعدادات الحساب</h2>
                <div class="bg-white/5 border border-white/5 p-6 rounded-[2rem] space-y-4">
                    <div class="flex justify-between border-b border-white/5 pb-3"><span class="text-slate-400 text-xs">الاسم:</span><span id="acc-name" class="font-bold text-sm">..</span></div>
                    <div class="flex justify-between border-b border-white/5 pb-3"><span class="text-slate-400 text-xs">رقم الهاتف:</span><span id="acc-phone" class="font-bold text-sm">..</span></div>
                    <div class="flex justify-between"><span class="text-slate-400 text-xs">تاريخ الانضمام:</span><span id="acc-date" class="font-bold text-[11px] text-slate-400">..</span></div>
                </div>
                <button onclick="logout()" class="w-full bg-red-500/10 text-red-400 border border-red-500/20 font-black py-4 rounded-2xl text-sm active:scale-95 transition">تسجيل الخروج من المنظومة</button>
            </div>

        </main>

        <nav class="fixed bottom-0 left-0 right-0 h-24 bg-black/80 backdrop-blur-2xl border-t border-white/5 grid grid-cols-5 items-center z-[500] px-2">
            <button onclick="changeView('home', this)" class="nav-item active"><i class="fas fa-home text-lg"></i><span>الرئيسية</span></button>
            <button onclick="changeView('games', this)" class="nav-item"><i class="fas fa-gamepad text-lg"></i><span>الألعاب</span></button>
            <button onclick="changeView('notifications', this)" class="nav-item relative">
                <i class="fas fa-bell text-lg"></i><span>الرسائل</span>
                <span id="msg-dot" class="hidden absolute top-4 right-6 w-2 h-2 bg-emerald-500 rounded-full animate-ping"></span>
            </button>
            <button onclick="changeView('orders', this)" class="nav-item"><i class="fas fa-receipt text-lg"></i><span>فواتيري</span></button>
            <button onclick="changeView('account', this)" class="nav-item"><i class="fas fa-user-gear text-lg"></i><span>حسابي</span></button>
        </nav>
    </div>

    <div id="sheet-overlay" class="fixed inset-0 bg-black/95 z-[1500] hidden" onclick="closeSheet()"></div>
    <div id="product-sheet" class="fixed bottom-[-100%] left-0 right-0 z-[1600] bg-[#05070a] border-t border-white/10 rounded-t-[3rem] p-10 transition-all duration-700">
        <img id="sh-img" class="w-full h-64 object-cover rounded-[2.5rem] mb-6">
        <h2 id="sh-name" class="text-2xl font-black mb-2"></h2>
        <p id="sh-price" class="text-3xl font-black text-emerald-400 mb-8"></p>
        <button id="sh-add-btn" class="w-full bg-emerald-500 text-black font-black py-4 rounded-2xl active:scale-95 transition">إضافة إلى سلة الشراء</button>
    </div>

    <div id="toast" class="fixed bottom-28 left-6 right-6 bg-emerald-500 text-black font-black py-4 px-6 rounded-2xl text-center z-[2000] shadow-2xl hidden animate-slideUp">..</div>

    <script src="script.js"></script>
</body>
</html>

