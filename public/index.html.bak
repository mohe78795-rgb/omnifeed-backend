<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>تموينات أبو حسين</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.plyr.io/3.7.8/plyr.css" />
    <script src="https://cdn.plyr.io/3.7.8/plyr.polyfilled.js"></script>
    <link rel="stylesheet" href="style.css">
</head>
<body class="bg-[#05070a] text-white min-h-screen pb-32">

    <div id="splash" class="fixed inset-0 z-[3000] bg-[#05070a] flex items-center justify-center">
        <h1 class="text-3xl font-black text-emerald-400 animate-pulse">تموينات أبو حسين</h1>
    </div>

    <!-- شاشة الدخول -->
    <div id="auth-screen" class="fixed inset-0 z-[2000] bg-black hidden flex items-center justify-center p-6">
        <div class="w-full max-w-md bg-slate-900 p-8 rounded-[2rem] border border-white/5 space-y-6">
            <h2 id="auth-title" class="text-2xl font-black text-emerald-400 text-center">تسجيل الدخول</h2>
            <div id="signup-name-container" class="hidden"><input type="text" id="auth-name" class="royal-input w-full" placeholder="الاسم الكامل"></div>
            <input type="tel" id="auth-phone" class="royal-input w-full" placeholder="رقم الهاتف">
            <input type="password" id="auth-pass" class="royal-input w-full" placeholder="الرمز السري">
            <button onclick="handleAuth()" id="auth-btn" class="w-full bg-emerald-500 text-black font-black py-4 rounded-xl">دخول آمن</button>
            <p class="text-center text-xs text-slate-400" onclick="toggleAuthMode()">ليس لديك حساب؟ <span class="text-emerald-400 underline cursor-pointer">إنشاء حساب</span></p>
        </div>
    </div>

    <div id="app-layout" class="hidden pt-28 px-6">
        <header class="fixed top-0 left-0 right-0 z-[1000] px-6 py-6 bg-black/60 backdrop-blur-xl border-b border-white/5 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div id="u-avatar" class="w-10 h-10 bg-emerald-500 text-black rounded-xl flex items-center justify-center font-black">..</div>
                <h1 class="font-black text-sm">تموينات أبو حسين</h1>
            </div>
            <div id="u-balance-top" class="px-4 py-2 bg-emerald-500/10 border border-emerald-500/20 rounded-full text-emerald-500 font-black text-[11px]">0 YER</div>
        </header>

        <!-- الرئيسية -->
        <div id="view-home" class="view-content space-y-6 animate-fadeIn">
            <div id="ad-video-container" class="hidden relative w-full aspect-video rounded-3xl overflow-hidden border border-white/5 bg-slate-950">
                <div id="player" data-plyr-provider="youtube" data-plyr-embed-id=""></div>
                <button onclick="toggleMute()" class="absolute bottom-4 left-4 z-10 w-10 h-10 bg-black/60 rounded-full flex items-center justify-center text-white text-xs">
                    <i id="mute-icon" class="fas fa-volume-mute"></i>
                </button>
            </div>
            <div id="categories-list" class="grid grid-cols-2 gap-4"></div>
        </div>

        <!-- المنتجات -->
        <div id="view-products" class="view-content hidden space-y-6 animate-fadeIn">
            <h2 id="cat-title-display" class="text-xl font-black text-emerald-400 mb-4"></h2>
            <div id="products-list" class="grid grid-cols-1 gap-3"></div>
        </div>

        <!-- الألعاب -->
        <div id="view-games" class="view-content hidden space-y-6 animate-fadeIn">
            <h2 class="text-2xl font-black">شحن الألعاب ⚡</h2>
            <div id="games-list" class="grid grid-cols-1 gap-3"></div>
            <div id="game-topup-panel" class="hidden bg-slate-900/40 p-6 rounded-3xl border border-white/5 space-y-4">
                <h3 id="selected-game-title" class="font-black text-emerald-400"></h3>
                <input type="text" id="game-player-id" class="royal-input w-full" placeholder="Player ID">
                <div id="game-denoms-list" class="grid grid-cols-2 gap-2"></div>
                <button onclick="processGameTopup()" class="w-full bg-emerald-500 text-black font-black py-4 rounded-xl">تأكيد الشحن</button>
            </div>
        </div>

        <!-- الدردشة -->
        <div id="view-notifications" class="view-content hidden flex flex-col h-[70vh] animate-fadeIn">
            <h2 class="text-2xl font-black mb-4">الدردشة والدعم ✉️</h2>
            <div id="messages-list" class="flex-1 overflow-y-auto space-y-3 p-4 bg-white/5 rounded-3xl border border-white/5 custom-scrollbar"></div>
            <div class="mt-4 flex gap-2">
                <input type="text" id="chat-input" class="flex-1 bg-white/5 border border-white/5 rounded-xl px-4 text-sm" placeholder="اكتب رسالتك...">
                <button onclick="sendUserMessage()" class="w-12 h-12 bg-emerald-500 text-black rounded-xl flex items-center justify-center"><i class="fas fa-paper-plane"></i></button>
            </div>
        </div>

        <!-- السلة -->
        <div id="view-cart" class="view-content hidden space-y-6 animate-fadeIn">
            <h2 class="text-2xl font-black">حقيبة التسوق</h2>
            <div id="cart-list" class="space-y-3"></div>
            <div class="p-5 bg-white/5 rounded-2xl flex justify-between items-center">
                <span>الإجمالي:</span>
                <span id="cart-total" class="text-xl font-black text-emerald-400">0 YER</span>
            </div>
            <button onclick="checkout()" class="w-full bg-emerald-500 text-black font-black py-4 rounded-xl mt-4">إتمام الشراء</button>
        </div>

        <!-- فواتيري -->
        <div id="view-orders" class="view-content hidden space-y-6 animate-fadeIn">
            <h2 class="text-2xl font-black">سجل العمليات</h2>
            <div id="orders-list" class="space-y-4"></div>
        </div>

        <!-- الحساب -->
        <div id="view-account" class="view-content hidden text-center space-y-6 animate-fadeIn">
            <div class="p-8 bg-white/5 rounded-3xl border border-white/5">
                <h3 id="acc-name" class="text-xl font-black"></h3>
                <p id="acc-phone" class="text-slate-400"></p>
            </div>
            <button onclick="logout()" class="w-full bg-red-500/20 text-red-500 py-4 rounded-xl border border-red-500/10">تسجيل الخروج</button>
        </div>

        <!-- النافبار السفلي -->
        <nav class="fixed bottom-0 left-0 right-0 h-24 bg-black/80 backdrop-blur-2xl border-t border-white/5 grid grid-cols-6 items-center z-[500] px-1">
            <button onclick="changeView('home', this)" class="nav-item active"><i class="fas fa-home"></i><span>الرئيسية</span></button>
            <button onclick="changeView('games', this)" class="nav-item"><i class="fas fa-gamepad"></i><span>الألعاب</span></button>
            <button onclick="changeView('cart', this)" class="nav-item"><i class="fas fa-shopping-bag"></i><span>السلة</span></button>
            <button onclick="changeView('orders', this)" class="nav-item"><i class="fas fa-receipt"></i><span>فواتيري</span></button>
            <button onclick="changeView('notifications', this)" class="nav-item relative"><i class="fas fa-comment-dots"></i><span>الدردشة</span></button>
            <button onclick="changeView('account', this)" class="nav-item"><i class="fas fa-user"></i><span>حسابي</span></button>
        </nav>
    </div>

    <!-- شيت المنتج -->
    <div id="sheet-overlay" class="fixed inset-0 bg-black/95 z-[1500] hidden" onclick="closeSheet()"></div>
    <div id="product-sheet" class="fixed bottom-[-100%] left-0 right-0 z-[1600] bg-[#05070a] border-t border-white/10 rounded-t-[3rem] p-10 transition-all duration-500">
        <img id="sh-img" class="w-full h-64 object-cover rounded-[2.5rem] mb-6">
        <h2 id="sh-name" class="text-2xl font-black mb-2"></h2>
        <p id="sh-price" class="text-3xl font-black text-emerald-400 mb-8"></p>
        <button id="sh-add-btn" class="w-full bg-emerald-500 text-black font-black py-4 rounded-2xl active:scale-95 transition">إضافة للسلة</button>
    </div>

    <script src="script.js"></script>
</body>
</html>
