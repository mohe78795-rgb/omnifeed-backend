* {
    font-family: 'Cairo', sans-serif;
    -webkit-tap-highlight-color: transparent;
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background-color: #05070a;
    color: #ffffff;
    overflow-x: hidden;
    position: relative;
}

/* خلفية متدرجة ذكية (Blobs) */
.blob {
    position: fixed;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(16, 185, 129, 0.08) 0%, transparent 70%);
    top: -50px;
    right: -50px;
    z-index: [-1];
    pointer-events: none;
}
.blob-2 {
    top: 60%;
    left: -100px;
    background: radial-gradient(circle, rgba(16, 185, 129, 0.05) 0%, transparent 70%);
}

/* تأثير الزجاج الفخم للأقسام والكروت (Card Glass) */
.card-glass {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(16, 185, 129, 0.08);
    box-shadow: 0 15px 35px -5px rgba(0,0,0,0.5);
    padding: 1.25rem;
    border-radius: 2rem;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
.card-glass:hover {
    background: rgba(16, 185, 129, 0.05);
    border-color: rgba(16, 185, 129, 0.3);
    transform: translateY(-5px);
}

/* توزيع الأقسام حسب الاختيار */
.cards-container {
    display: grid;
    gap: 1rem;
}
.cards-container.mode-dual { grid-template-cols: repeat(2, minmax(0, 1fr)); }
.cards-container.mode-matrix { grid-template-cols: repeat(3, minmax(0, 1fr)); }
.cards-container.mode-list { grid-template-cols: repeat(1, minmax(0, 1fr)); }
.cards-container.mode-list .card-glass {
    display: flex;
    align-items: center;
    gap: 1.25rem;
}
.cards-container.mode-list .card-glass img {
    width: 70px;
    height: 70px;
    margin-bottom: 0;
}

/* حقول الإدخال الملكية */
.royal-input {
    width: 100%;
    padding: 1rem 1.25rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 1.25rem;
    font-size: 0.875rem;
    color: white;
    outline: none;
    transition: 0.3s;
}
.royal-input:focus {
    border-color: #10b981;
    background: rgba(16, 185, 129, 0.02);
}

/* عناصر شريط التنقل السفلي الخماسي الموحد */
.nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    color: #64748b;
    font-size: 0.625rem;
    font-weight: 700;
    transition: 0.3s;
    height: 100%;
}
.nav-item i { transition: 0.3s; }
.nav-item.active { color: #10b981; }
.nav-item.active i { transform: scale(1.2) translateY(-3px); }

/* تأثيرات الأنيميشن الفخمة */
@keyframes fadeIn { from { opacity: 0; transform: scale(0.98); } to { opacity: 1; transform: scale(1); } }
@keyframes slideUp { from { transform: translateY(30px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
.animate-fadeIn { animation: fadeIn 0.4s ease-out forwards; }
.animate-slideUp { animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

