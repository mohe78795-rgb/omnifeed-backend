/* --- إعدادات التصميم الأساسية --- */
@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap');
body { font-family: 'Cairo', sans-serif; background-color: #08090a; color: #ffffff; margin: 0; padding: 0; }

/* --- الشريط السفلي (الذي كان يسبب المشكلة) --- */
.cyber-nav {
    display: grid !important;
    grid-template-columns: repeat(6, 1fr) !important; /* توزيع الـ 6 أزرار */
    height: 80px !important;
    background: #0d0f11 !important;
    border-top: 2px solid #171a1f !important;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 500;
}

.nav-item {
    display: flex !important;
    flex-direction: column !important; /* الأيقونة فوق النص */
    align-items: center !important;
    justify-content: center !important;
    gap: 4px !important;
    color: #4b5563 !important;
    text-decoration: none;
    transition: 0.3s;
    background: transparent;
    border: none;
    outline: none;
}

.nav-item i { font-size: 20px !important; }
.nav-item span { font-size: 10px !important; font-weight: bold; }

/* تأثير الزر النشط */
.nav-item.active { color: #ffcc00 !important; }
.nav-item.active::before {
    content: ''; position: absolute; top: 0; width: 40px; height: 3px;
    background: #ffcc00; border-radius: 0 0 4px 4px;
}

