/* تصميم واجهات الجيل الجديد الفاخرة */
:root {
    --bg-base: #050709;
    --accent: #10b981;
    --font-family: 'Cairo', sans-serif;
    --border-subtle: rgba(255, 255, 255, 0.04);
}

body {
    font-family: var(--font-family);
    background-color: var(--bg-base);
    letter-spacing: -0.01em;
    -webkit-font-smoothing: antialiased;
}

/* هالات الضوء الخلفية الذكية - لمنح الواجهة عمقاً خفياً */
.ambience-wrapper {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
}
.glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.04;
}
.orb-primary {
    width: 350px; height: 350px;
    background: #10b981;
    top: -50px; right: -50px;
}
.orb-secondary {
    width: 300px; height: 300px;
    background: #3b82f6;
    bottom: -50px; left: -50px;
}

/* البارات والقوائم الفخمة بنقاء زجاجي (Opaque glass) */
.top-bar, .bottom-nav {
    background-color: rgba(5, 7, 9, 0.75);
    border-color: var(--border-subtle);
}

/* التبويبات السفلية */
.nav-tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    color: #64748b;
    transition: all 0.2s ease;
    height: 100%;
}
.nav-tab i { font-size: 15px; }
.nav-tab span { font-size: 9px; font-weight: 600; }
.nav-tab.active { color: #ffffff; }

/* أزرار تنسيق العرض المصغرة */
.layout-pill {
    font-size: 10px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 8px;
    color: #64748b;
    transition: all 0.2s;
}
.layout-pill.active {
    background-color: rgba(255, 255, 255, 0.05);
    color: #ffffff;
}

/* حقول المدخلات العالمية الملساء */
.modern-input {
    width: 100%;
    padding: 14px 16px;
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    font-size: 13px;
    color: #ffffff;
    outline: none;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}
.modern-input:focus {
    border-color: rgba(255, 255, 255, 0.2);
    background-color: rgba(255, 255, 255, 0.04);
}

/* الكروت النظيفة الفخمة للكاشير والأقسام (Pure Clean Cards) */
.premium-card {
    background-color: rgba(255, 255, 255, 0.01);
    border: 1px solid rgba(255, 255, 255, 0.03);
    border-radius: 20px;
    padding: 14px;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
}
.premium-card:active {
    transform: scale(0.98);
    background-color: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.08);
}

/* الأزرار الفاخرة الموحدة */
.prime-btn {
    background-color: #ffffff;
    color: #000000;
    transition: opacity 0.2s;
}
.prime-btn:active { opacity: 0.85; }

.checkout-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 15px;
    border-radius: 14px;
    font-size: 13px;
    font-weight: 700;
    transition: all 0.2s;
}
.checkout-btn:active { transform: scale(0.98); opacity: 0.9; }

/* التحكم بمرونة الشبكات المستجابة */
.categories-grid.grid-dual { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
.categories-grid.grid-matrix { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
.categories-grid.grid-list { display: flex; flex-direction: column; gap: 12px; }

/* أنيميشن ناعم للواجهات السلسة */
@keyframes slideUp { from { transform: translateY(15px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
.animate-slide-up { animation: slideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

/* شاشة التحميل الرشيقة */
.minimal-loader {
    width: 20px; height: 20px;
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-top-color: #ffffff;
    border-radius: 50%;
    margin-top: 24px;
    animation: rotateLoader 0.8s linear infinite;
}
@keyframes rotateLoader { to { transform: rotate(360deg); } }

.auth-card {
    background-color: #0c0f14;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 24px;
}
