body {
    font-family: 'Cairo', sans-serif;
    background-color: #08090a;
    color: #ffffff;
    overflow-x: hidden;
    position: relative;
    -webkit-tap-highlight-color: transparent;
}

.cyber-header {
    background: #0d0f11;
    border-bottom: 1px solid #171a1f;
}

.cyber-nav {
    background: #0d0f11;
    border-top: 1px solid #171a1f;
}

.nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    height: 100%;
}

.royal-input {
    width: 100%;
    padding: 1rem 1.25rem;
    background: #0d0f11;
    border: 1px solid #1d2127;
    border-radius: 1.25rem;
    font-size: 12px;
    color: #ffffff;
    outline: none;
    transition: all 0.2s ease;
    text-align: right;
}
.royal-input:focus {
    border-color: #ffcc00;
    background: #121418;
}

.btn-payment {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    padding: 1.1rem;
    border-radius: 1.25rem;
    font-size: 13px;
    transition: all 0.2s ease;
    cursor: pointer;
}
.btn-payment:active {
    transform: scale(0.98);
}

::-webkit-scrollbar {
    width: 0px;
    background: transparent;
}

