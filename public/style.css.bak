body {
    font-family: 'Cairo', sans-serif;
    background-color: #05070a;
    overflow-x: hidden;
    position: relative;
    -webkit-tap-highlight-color: transparent;
}

/* حل مشكلة تداخل وفوضى الخلفيات */
.main-blob-1 {
    position: fixed;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(16, 185, 129, 0.06) 0%, rgba(0,0,0,0) 70%);
    top: -50px;
    right: -50px;
    z-index: -1;
    pointer-events: none;
}
.main-blob-2 {
    position: fixed;
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(16, 185, 129, 0.04) 0%, rgba(0,0,0,0) 70%);
    bottom: -100px;
    left: -100px;
    z-index: -1;
    pointer-events: none;
}

/* القوالب الزجاجية المعتمدة للمتجر */
.card-glass {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.02) 0%, rgba(255, 255, 255, 0.005) 100%);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 1.5rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
.card-glass:active {
    transform: scale(0.96);
    border-color: rgba(16, 185, 129, 0.2);
}

/* أشرطة التنقل والمحاذاة المضمونة للـ الألعاب والمتجر */
.nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    color: #94a3b8;
    transition: all 0.2s ease;
    width: 60px;
}
.nav-item span { font-size: 10px; font-weight: 700; }
.nav-item i { font-size: 18px; }

/* أنظمة تخطيط المنتجات الشغالة والمنظمة دون تراكب */
.cards-container.mode-dual { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
.cards-container.mode-matrix { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.6rem; }
.cards-container.mode-list { display: flex; flex-direction: column; gap: 0.75rem; }

.scrollbar-none::-webkit-scrollbar { display: none; }
.scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }

