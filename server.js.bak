  .then(() => console.log("✅ تم الاتصال بقاعدة بيانات aptomix_card بنجاح"))
  .catch(err => console.error("❌ خطأ في الاتصال بقاعدة البيانات:", err));

const packageSchema = new mongoose.Schema({}, { strict: false, collection: 'packages' });
const Package = mongoose.model('Package', packageSchema);

// ==========================================
// 2. دالة توليد التوكين (Token Generator) الرسمي
// ==========================================
const generateToken = (transid, mobile) => {
  const hashPassword = crypto.createHash('md5').update(PROVIDER_CONFIG.password).digest('hex');
  const rawString = hashPassword + transid + PROVIDER_CONFIG.username + mobile;
  return crypto.createHash('md5').update(rawString).digest('hex');
};

// ==========================================
// 3. مسارات يمن موبايل (Yemen Mobile) وفحص السلفة
// ==========================================
app.get('/api/provider/yemen-mobile', async (req, res) => {
  try {
    const { action, mobile, amount, offerkey, method, solfa } = req.query;
    if (!mobile) return res.status(400).json({ success: false, message: "رقم الهاتف مطلوب" });

    const transid = Date.now().toString();
    const token = generateToken(transid, mobile);
    let requestUrl = "";

    if (action === "query") {
      requestUrl = `${PROVIDER_CONFIG.apiUrl}yem?action=query&userid=${PROVIDER_CONFIG.userId}&mobile=${mobile}&transid=${transid}&token=${token}`;
    } else if (action === "bill") {
      requestUrl = `${PROVIDER_CONFIG.apiUrl}yem?action=bill&userid=${PROVIDER_CONFIG.userId}&mobile=${mobile}&transid=${transid}&token=${token}&amount=${amount}`;
    } else if (action === "billoffer") {
      requestUrl = `${PROVIDER_CONFIG.apiUrl}offeryem?action=billoffer&userid=${PROVIDER_CONFIG.userId}&mobile=${mobile}&transid=${transid}&token=${token}&offerkey=${offerkey}&method=${method || 'New'}&solfa=${solfa || 'N'}`;
    } else if (action === "solfa") {
      // مسار فحص السلفة
      requestUrl = `${PROVIDER_CONFIG.apiUrl}yem?action=solfa&userid=${PROVIDER_CONFIG.userId}&mobile=${mobile}&transid=${transid}&token=${token}`;
    }

    const response = await axios.get(requestUrl);
    res.status(200).json({ success: true, data: response.data });
  } catch (error) {
    res.status(500).json({ success: false, error: error.message });
  }
});

// ==========================================
// 4. مسارات يمن فورجي (Yem 4G)
// ==========================================
app.get('/api/provider/yem4g', async (req, res) => {
  try {
    const { action, mobile, amount, type } = req.query; // action: bill or query, type: 1 (باقة), 2 (رصيد), 3 (تغيير باقة)
    if (!mobile) return res.status(400).json({ success: false, message: "رقم الهاتف مطلوب" });

    const transid = Date.now().toString();
    const token = generateToken(transid, mobile);
    let requestUrl = "";

    if (action === "query") {
      requestUrl = `${PROVIDER_CONFIG.apiUrl}yem4g?mobile=${mobile}&transid=${transid}&token=${token}&userid=${PROVIDER_CONFIG.userId}&action=query`;
    } else if (action === "bill") {
      requestUrl = `${PROVIDER_CONFIG.apiUrl}yem4g?mobile=${mobile}&transid=${transid}&token=${token}&userid=${PROVIDER_CONFIG.userId}&action=bill&amount=${amount}&type=${type}`;
    }

    const response = await axios.get(requestUrl);
    res.status(200).json({ success: true, data: response.data });
  } catch (error) {
    res.status(500).json({ success: false, error: error.message });
  }
});

// ==========================================
// 5. مسارات شبكة يو (YOU / MTN)
// ==========================================
app.get('/api/provider/you/open-balance', async (req, res) => {
  try {
    const { mobile, amount, type } = req.query;
    const transid = Date.now().toString();
    const token = generateToken(transid, mobile);

    const netCredit = (parseFloat(amount) / 1.195).toFixed(2);
    const requestUrl = `${PROVIDER_CONFIG.apiUrl}mtn?action=bill&userid=${PROVIDER_CONFIG.userId}&mobile=${mobile}&transid=${transid}&token=${token}&num=${amount}&type=${type || 'prepaid'}&israsid=1`;
    
    const response = await axios.get(requestUrl);
    res.status(200).json({
      success: true,
      taxDetails: { billedAmount: amount, receivedCredit: netCredit, taxFactor: 1.195 },
      data: response.data
    });
  } catch (error) {
    res.status(500).json({ success: false, error: error.message });
  }
});

app.get('/api/provider/you/bill', async (req, res) => {
  try {
    const { isOffer, mobile, num, type } = req.query;
    const transid = Date.now().toString();
    const token = generateToken(transid, mobile);

    let requestUrl = "";
    if (isOffer === "true") {
      requestUrl = `${PROVIDER_CONFIG.apiUrl}mtnoffer?userid=${PROVIDER_CONFIG.userId}&mobile=${mobile}&transid=${transid}&token=${token}&num=${num}`;
    } else {
      requestUrl = `${PROVIDER_CONFIG.apiUrl}mtn?action=bill&userid=${PROVIDER_CONFIG.userId}&mobile=${mobile}&transid=${transid}&token=${token}&num=${num}&type=${type || 'prepaid'}`;
    }

    const response = await axios.get(requestUrl);
    res.status(200).json({ success: true, data: response.data });
  } catch (error) {
    res.status(500).json({ success: false, error: error.message });
  }
});

// ==========================================
// 6. مسارات سبأفون (Sabaphone & Sbay South)
// ==========================================
app.get('/api/provider/sabaphone', async (req, res) => {
  try {
    const { type, mobile, num } = req.query; 
    const transid = Date.now().toString();
    const token = generateToken(transid, mobile);

    let requestUrl = "";
    if (type === "offer") {
      requestUrl = `${PROVIDER_CONFIG.apiUrl}sabaoffer?userid=${PROVIDER_CONFIG.userId}&mobile=${mobile}&transid=${transid}&token=${token}&num=${num}`;
    } else if (type === "units") {
      requestUrl = `${PROVIDER_CONFIG.apiUrl}sabaunits?userid=${PROVIDER_CONFIG.userId}&mobile=${mobile}&transid=${transid}&token=${token}&num=${num}`;
    } else if (type === "sbay") {
      requestUrl = `${PROVIDER_CONFIG.apiUrl}sbay?action=bill&userid=${PROVIDER_CONFIG.userId}&mobile=${mobile}&transid=${transid}&token=${token}&num=${num}`;
    } else if (type === "sbayoffer") {
      requestUrl = `${PROVIDER_CONFIG.apiUrl}sbayoffer?userid=${PROVIDER_CONFIG.userId}&mobile=${mobile}&transid=${transid}&token=${token}&num=${num}`;
    } else {
      requestUrl = `${PROVIDER_CONFIG.apiUrl}sabaphone?action=bill&userid=${PROVIDER_CONFIG.userId}&mobile=${mobile}&transid=${transid}&token=${token}&num=${num}`;
    }

    const response = await axios.get(requestUrl);
    res.status(200).json({ success: true, data: response.data });
  } catch (error) {
    res.status(500).json({ success: false, error: error.message });
  }
});

// ==========================================
// 7. مسارات شركة واي (Y Telecom)
// ==========================================
app.get('/api/provider/why', async (req, res) => {
  try {
    const { mobile, num, rasid, packageid } = req.query;
    const transid = Date.now().toString();
    const token = generateToken(transid, mobile);

    let requestUrl = `${PROVIDER_CONFIG.apiUrl}why?action=bill&userid=${PROVIDER_CONFIG.userId}&mobile=${mobile}&transid=${transid}&token=${token}`;
    if (num) requestUrl += `&num=${num}`;
    if (rasid) requestUrl += `&rasid=${rasid}`;
    if (packageid) requestUrl += `&packageid=${packageid}`;

    const response = await axios.get(requestUrl);
    res.status(200).json({ success: true, data: response.data });
  } catch (error) {
    res.status(500).json({ success: false, error: error.message });
  }
});

// ==========================================
// 8. مسارات شحن الجملة (Wholesale / Gomla)
// ==========================================
app.get('/api/provider/gomla', async (req, res) => {
  try {
    const { provider, mobile, num } = req.query; // provider: sabagomla, mtngomla, mobilegomla
    if (!mobile || !provider) {
      return res.status(400).json({ success: false, message: "رقم الهاتف واختيار الشبكة مطلوبان" });
    }

    const transid = Date.now().toString();
    const token = generateToken(transid, mobile);
    let requestUrl = "";

    if (provider === "sabagomla") {
      requestUrl = `${PROVIDER_CONFIG.apiUrl}sabagomla?userid=${PROVIDER_CONFIG.userId}&mobile=${mobile}&transid=${transid}&token=${token}&num=${num}`;
    } else if (provider === "mtngomla") {
      requestUrl = `${PROVIDER_CONFIG.apiUrl}mtngomla?userid=${PROVIDER_CONFIG.userId}&mobile=${mobile}&transid=${transid}&token=${token}&num=${num}`;
    } else if (provider === "mobilegomla") {
      requestUrl = `${PROVIDER_CONFIG.apiUrl}mobilegomla?userid=${PROVIDER_CONFIG.userId}&mobile=${mobile}&transid=${transid}&token=${token}&num=${num}`;
    } else {
      return res.status(400).json({ success: false, message: "مزود خدمة غير معروف لشحن الجملة" });
    }

    const response = await axios.get(requestUrl);
    res.status(200).json({ success: true, data: response.data });
  } catch (error) {
    res.status(500).json({ success: false, error: error.message });
  }
});

// ==========================================
// 9. مسارات الهاتف الثابت والإنترنت (Yemen Post ADSL & Phone)
// ==========================================
app.get('/api/provider/post', async (req, res) => {
  try {
    const { action, mobile, amount, type } = req.query; // action: query or bill, type: adsl or line
    const transid = Date.now().toString();
    const token = generateToken(transid, mobile);

    let requestUrl = `${PROVIDER_CONFIG.apiUrl}post?userid=${PROVIDER_CONFIG.userId}&mobile=${mobile}&transid=${transid}&token=${token}&action=${action}`;
    if (action === "bill") {
      requestUrl += `&amount=${amount}&type=${type}`;
    }

    const response = await axios.get(requestUrl);
    res.status(200).json({ success: true, data: response.data });
  } catch (error) {
    res.status(500).json({ success: false, error: error.message });
  }
});

